---
// Shared list renderer for /writing, /writing/forbes, /writing/linkedin.
// Cards link directly to the external source URL.
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'writing'>[];
  groupByYear?: boolean;
}

const { posts, groupByYear = true } = Astro.props;

let groups: [string, CollectionEntry<'writing'>[]][];
if (groupByYear) {
  const map = new Map<string, CollectionEntry<'writing'>[]>();
  for (const p of posts) {
    const y = p.data.date.getFullYear().toString();
    if (!map.has(y)) map.set(y, []);
    map.get(y)!.push(p);
  }
  groups = [...map.entries()].sort(([a], [b]) => Number(b) - Number(a));
} else {
  groups = [['', posts]];
}

const isExternal = (url: string) => /^https?:\/\//i.test(url);
---
{groups.map(([year, items]) => (
  <section style="margin: 2.5rem 0">
    {year && (
      <h2 style="border-bottom:1px solid var(--c-border); padding-bottom:0.4rem; margin-bottom:1rem; font-family:var(--font-sans); font-size:1rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--c-text-muted)">{year}</h2>
    )}
    <ul class="card-list">
      {items.map(post => (
        <li>
          <a
            class="card"
            href={post.data.url}
            target={isExternal(post.data.url) ? '_blank' : undefined}
            rel={isExternal(post.data.url) ? 'noopener' : undefined}
          >
            <div class="card-meta">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
              </time>
              <span class={`tag tag-${post.data.source.toLowerCase()}`}>{post.data.source}</span>
              {post.data.tags?.slice(0, 2).map(t => <span class="tag">{t}</span>)}
            </div>
            <h3 class="card-title">{post.data.title}</h3>
            {post.data.excerpt && <p class="card-excerpt">{post.data.excerpt}</p>}
          </a>
        </li>
      ))}
    </ul>
  </section>
))}
