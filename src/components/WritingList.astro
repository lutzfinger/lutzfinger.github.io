---
// Shared list renderer for /writing, /writing/forbes, /writing/linkedin.
// Cards link directly to the external source URL.
// Emits one BlogPosting JSON-LD per card with a per-page OG image so
// search engines and LLMs see structured data even though the cards
// link outbound and we have no per-article page.
import type { CollectionEntry } from 'astro:content';
import { SITE } from '~/consts';

interface Props {
  posts: CollectionEntry<'writing'>[];
  groupByYear?: boolean;
}

const { posts, groupByYear = true } = Astro.props;

let groups: [string, CollectionEntry<'writing'>[]][];
if (groupByYear) {
  const map = new Map<string, CollectionEntry<'writing'>[]>();
  for (const p of posts) {
    const y = p.data.date.getFullYear().toString();
    if (!map.has(y)) map.set(y, []);
    map.get(y)!.push(p);
  }
  groups = [...map.entries()].sort(([a], [b]) => Number(b) - Number(a));
} else {
  groups = [['', posts]];
}

const isExternal = (url: string) => /^https?:\/\//i.test(url);

// Emit one BlogPosting per entry. `image` is the shared writing-section OG
// (the per-page OG generator can be extended later to make one PNG per post
// if we ever decide each writing entry deserves a unique card).
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: posts.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'BlogPosting',
      headline: p.data.title,
      datePublished: p.data.date.toISOString(),
      author: { '@type': 'Person', name: SITE.author, url: SITE.url },
      url: p.data.url,
      image: `${SITE.url}/og/writing-${p.data.source.toLowerCase()}.png`,
      publisher: { '@type': 'Organization', name: p.data.source },
      description: p.data.excerpt ?? undefined,
    },
  })),
};
---
<script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />

{groups.map(([year, items]) => (
  <section style="margin: 2.5rem 0">
    {year && (
      <h2 style="border-bottom:1px solid var(--c-border); padding-bottom:0.4rem; margin-bottom:1rem; font-family:var(--font-sans); font-size:1rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--c-text-muted)">{year}</h2>
    )}
    <ul class="card-list">
      {items.map(post => {
        // Stable per-card anchor; the entry id carries the source subdir
        // (e.g. "forbes/slug"), so flatten the slash for a clean fragment.
        const anchor = post.id.replace(/\//g, '-');
        return (
        <li id={anchor}>
          <a
            class="card"
            href={post.data.url}
            target={isExternal(post.data.url) ? '_blank' : undefined}
            rel={isExternal(post.data.url) ? 'noopener' : undefined}
          >
            <div class="card-meta">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
              </time>
              <span class={`tag tag-${post.data.source.toLowerCase()}`}>{post.data.source}</span>
            </div>
            <h3 class="card-title">{post.data.title}</h3>
            {post.data.excerpt && <p class="card-excerpt">{post.data.excerpt}</p>}
          </a>
          <a class="card-anchor" href={`#${anchor}`} aria-label={`Link to "${post.data.title}"`}>#</a>
        </li>
        );
      })}
    </ul>
  </section>
))}
