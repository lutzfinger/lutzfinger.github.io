---
import Base from './Base.astro';
import { SITE } from '~/consts';

interface Props {
  title: string;
  description?: string;
  date: Date;
  source: string;
  url?: string;
  canonical?: string;
  tags?: string[];
  wordCount?: number;
  image?: string;
}

const { title, description, date, source, url, canonical, tags = [], wordCount, image } = Astro.props;
const isoDate = date.toISOString();
const dateLabel = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  datePublished: isoDate,
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.url,
  },
  publisher: {
    '@type': 'Person',
    name: SITE.author,
  },
};
if (description) jsonLd.description = description;
if (canonical || url) jsonLd.mainEntityOfPage = canonical || url;
if (image) jsonLd.image = new URL(image, SITE.url).href;
if (wordCount) jsonLd.wordCount = wordCount;
if (tags.length) jsonLd.keywords = tags.join(', ');
---
<Base
  title={title}
  description={description}
  type="article"
  publishedTime={isoDate}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <article>
    <header>
      <h1>{title}</h1>
      <div class="article-meta">
        <time datetime={isoDate}>{dateLabel}</time>
        <span>·</span>
        <span class={`tag tag-${source.toLowerCase()}`}>{source}</span>
        {wordCount && <><span>·</span><span>{Math.ceil(wordCount / 220)} min read</span></>}
        {tags.length > 0 && (
          <>
            <span>·</span>
            {tags.slice(0, 4).map(t => <span class="tag">{t}</span>)}
          </>
        )}
      </div>
    </header>
    <div class="article-body">
      <slot />
    </div>
    {url && source === 'Forbes' && (
      <aside class="article-source">
        <strong>Originally published on Forbes.</strong>
        <p style="margin-top:0.4rem">Read the full article at <a href={url} rel="canonical">{url}</a>.</p>
      </aside>
    )}
    {url && source === 'LinkedIn' && url.includes('linkedin.com') && (
      <aside class="article-source">
        Originally published on <a href={url} rel="canonical">LinkedIn</a>.
      </aside>
    )}
  </article>
</Base>
