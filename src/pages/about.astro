---
import Base from '~/layouts/Base.astro';
import { SITE } from '~/consts';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  url: `${SITE.url}/about/`,
  jobTitle: 'Head of AI, Zoovu · Data Scientist in Residence, Cornell · Venture Partner, Cherry Ventures',
  worksFor: { '@type': 'Organization', name: 'Zoovu' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'INSEAD' },
    { '@type': 'CollegeOrUniversity', name: 'Technische Universität Berlin' },
  ],
  sameAs: [
    SITE.social.linkedin, SITE.social.forbes, SITE.social.x,
    SITE.social.youtube, SITE.social.instagram,
    'https://scholar.google.com/citations?user=tg0FO3wAAAAJ',
  ],
};
---
<Base
  title="About"
  description="Lutz Finger — Head of AI at Zoovu, Data Scientist in Residence at Cornell, Venture Partner at Cherry Ventures. Two founder exits (R2Decide 2025, Fisheye Analytics 2013). Ex-Google, ex-LinkedIn, ex-Snap."
  jsonLd={personJsonLd}
>
  <h1>About</h1>

  <p style="font-size:1.15rem; line-height:1.55">
    I help people turn AI from a headline into a product.
  </p>

  <h2>Currently</h2>
  <ul>
    <li><strong>Head of AI</strong> · <a href="https://zoovu.com" rel="noopener">Zoovu</a></li>
    <li><strong>Data Scientist in Residence</strong> · Cornell SC Johnson College of Business</li>
    <li><strong>Venture Partner</strong> · <a href="https://www.cherry.vc/" rel="noopener">Cherry Ventures</a></li>
  </ul>

  <h2>Founder exits</h2>
  <ul>
    <li><strong>R2Decide</strong> — AI-driven decision tooling for e-commerce. Sold <strong>2025</strong>.</li>
    <li><strong>Fisheye Analytics</strong> — social-media analytics + bot detection. Sold <strong>2013</strong>.</li>
  </ul>

  <h2>Formerly</h2>
  <p>
    <strong>Snap Inc.</strong> · <strong>Google</strong> · <strong>LinkedIn</strong> (Director, Data Science).
  </p>

  <h2>Author</h2>
  <ul>
    <li><a href={SITE.social.forbes} rel="noopener">Forbes column on AI</a> — 50+ articles.</li>
    <li><a href="/book/"><em>Ask, Measure, Learn</em></a> (O'Reilly, 2014) — with Soumitra Dutta.</li>
    <li><a href="/ecornell/"><em>Designing and Building AI Solutions</em></a> — the Cornell certificate.</li>
    <li><a href="https://scholar.google.com/citations?user=tg0FO3wAAAAJ" rel="noopener">Google Scholar</a> — academic publications.</li>
  </ul>

  <h2>Education</h2>
  <p>MBA, INSEAD · MS Quantum Physics, TU Berlin.</p>

  <p style="margin-top:2.5rem; color:var(--c-text-muted)">
    More on <a href={SITE.social.linkedin} rel="noopener">LinkedIn</a> · talk to me at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
  </p>
</Base>
