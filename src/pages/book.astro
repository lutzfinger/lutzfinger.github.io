---
import Base from '~/layouts/Base.astro';
import { SITE } from '~/consts';

const bookJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: 'Ask, Measure, Learn',
  image: `${SITE.url}/img/book-cover.jpg`,
  author: [
    { '@type': 'Person', name: 'Lutz Finger', url: SITE.url },
    { '@type': 'Person', name: 'Soumitra Dutta' },
  ],
  bookFormat: 'https://schema.org/Paperback',
  inLanguage: 'en',
  isbn: '978-1449336752',
  numberOfPages: 188,
  datePublished: '2014-02-04',
  publisher: { '@type': 'Organization', name: "O'Reilly Media" },
  about: ['Social Media Analytics', 'Data Science', 'Marketing Measurement', 'Business Intelligence'],
  url: `${SITE.url}/book/`,
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Book', item: `${SITE.url}/book/` },
  ],
};
---
<Base
  title="Ask, Measure, Learn"
  description="Ask, Measure, Learn — by Lutz Finger and Soumitra Dutta (O'Reilly, 2014). A practical guide to using social and behavioral data to ask the right questions, measure what matters, and actually learn from the answers."
  image="/img/book-cover.jpg"
  jsonLd={[bookJsonLd, breadcrumbJsonLd]}
>
  <div class="book-hero">
    <figure class="book-cover-wrap">
      <img
        src="/img/book-cover.jpg"
        alt="Cover of the book Ask, Measure, Learn by Lutz Finger and Soumitra Dutta"
        width="300"
        height="240"
        loading="eager"
        decoding="async"
      />
    </figure>
    <div>
      <h1 style="margin-top:0">Ask, Measure, Learn</h1>
      <p class="hero-sub">
        Using data — social media, behavior, signals — to actually learn
        something useful. Co-authored with <strong>Soumitra Dutta</strong>;
        published by O'Reilly.
      </p>
    </div>
  </div>

  <p>
    <strong>Authors:</strong> Lutz Finger and Soumitra Dutta (then Dean of
    Cornell's SC Johnson College of Business; now Dean of the Saïd Business
    School at the University of Oxford).<br>
    <strong>Publisher:</strong> O'Reilly Media.<br>
    <strong>Published:</strong> February 4, 2014.<br>
    <strong>ISBN:</strong> 978-1449336752.<br>
    <strong>Pages:</strong> 188.
  </p>

  <h2>What's in it</h2>
  <ul>
    <li>How to frame a measurable question from a fuzzy business goal.</li>
    <li>Designing the right metrics — outcome vs. output.</li>
    <li>Reading social and behavioral data without fooling yourself.</li>
    <li>The feedback loop: <em>ask → measure → learn → ship</em>.</li>
    <li>Case studies from LinkedIn, consumer brands, and beyond.</li>
  </ul>

  <h2>Get it</h2>
  <ul>
    <li><a href="https://www.oreilly.com/library/view/ask-measure-learn/9781449373047/" rel="noopener">O'Reilly Media</a></li>
    <li><a href="https://www.amazon.com/Ask-Measure-Learn-Analytics-Right/dp/1449336752" rel="noopener">Amazon</a></li>
    <li><a href="https://www.google.com/books/edition/Ask_Measure_Learn/QbV1AwAAQBAJ" rel="noopener">Google Books preview</a></li>
  </ul>

  <h2>About the co-author</h2>
  <p>
    <a href="https://www.sbs.ox.ac.uk/about-us/people/soumitra-dutta" rel="noopener">Soumitra Dutta</a>
    is Dean of the Saïd Business School at the University of Oxford. Previously he was Anne and Elmer
    Lindseth Dean of Cornell SC Johnson College of Business, and before that a long-tenured professor
    at INSEAD. He has authored multiple books on innovation, technology, and business, including the
    <em>Global Innovation Index</em>.
  </p>
</Base>

<style>
  .book-hero {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2rem;
    align-items: center;
    margin-bottom: 2rem;
  }
  .book-cover-wrap img {
    border-radius: 6px;
    border: 1px solid var(--c-border);
    box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    width: 220px;
    height: auto;
  }
  @media (max-width: 640px) {
    .book-hero { grid-template-columns: 1fr; gap: 1rem; text-align: center; }
    .book-cover-wrap img { width: 160px; margin: 0 auto; }
  }
</style>
