---
import Base from '~/layouts/Base.astro';
import { SITE } from '~/consts';

const bookJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: 'Ask, Measure, Learn',
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.url,
  },
  bookFormat: 'https://schema.org/Paperback',
  inLanguage: 'en',
  isbn: '978-1491904909',
  publisher: {
    '@type': 'Organization',
    name: "O'Reilly Media",
  },
  about: ['Social Media Analytics', 'Data Science', 'Marketing Measurement', 'Artificial Intelligence'],
  url: `${SITE.url}/book/`,
};
---
<Base
  title="Ask, Measure, Learn"
  description="Lutz Finger's book on using social media data and analytics to drive better product and marketing decisions. Published by O'Reilly."
  jsonLd={bookJsonLd}
>
  <h1>Ask, Measure, Learn</h1>
  <p class="hero-sub">
    My book on using data — social media, behavior, signals — to actually
    learn something useful.
  </p>

  <p>
    Published by O'Reilly Media. A practical guide for product teams, marketers,
    and data folks who want to ask the right questions, measure the right
    things, and learn fast enough to ship.
  </p>

  <h2>What's in it</h2>
  <ul>
    <li>How to frame a measurable question from a fuzzy business goal.</li>
    <li>Designing the right metrics — outcome vs. output.</li>
    <li>Reading social and behavioral data without fooling yourself.</li>
    <li>The feedback loop: ask → measure → learn → ship.</li>
    <li>Case studies from LinkedIn and beyond.</li>
  </ul>

  <h2>Get it</h2>
  <ul>
    <li><a href="https://www.amazon.com/Ask-Measure-Learn-Lutz-Finger/dp/1491904909">Amazon</a></li>
    <li><a href="https://www.oreilly.com/library/view/ask-measure-learn/9781491947067/">O'Reilly</a></li>
  </ul>
</Base>
