---
import Base from '~/layouts/Base.astro';
import { SITE } from '~/consts';
---
<Base
  title="Contact"
  description="How to reach Lutz Finger — speaking inquiries, advisory work, press, and general questions."
>
  <h1>Contact</h1>
  <p>The best way to reach me: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>

  <h2>Speaking</h2>
  <p>
    For keynote and workshop bookings, please email with the date range,
    audience, location, and topic. I respond to most inquiries within a week.
    Past and upcoming sessions are on <a href="/speaking/">/speaking</a>.
  </p>

  <h2>Advisory</h2>
  <p>
    I take on a small number of advisory engagements with companies building
    AI products. Email with a one-paragraph description of what you're working
    on.
  </p>

  <h2>Press</h2>
  <p>
    For interview requests, please email with deadline, outlet, and topic.
  </p>

  <h2>Elsewhere</h2>
  <ul>
    <li><a href={SITE.social.linkedin}>LinkedIn</a> — DMs open, slower than email.</li>
    <li><a href={SITE.social.forbes}>Forbes column</a></li>
    <li><a href={SITE.social.x}>X (Twitter)</a></li>
  </ul>
</Base>
