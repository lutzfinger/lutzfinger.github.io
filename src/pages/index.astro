---
import Base from '~/layouts/Base.astro';
import { SITE } from '~/consts';
import { getCollection } from 'astro:content';

// Auto-pull the latest from /writing and /speaking so the homepage never goes stale.
const writing = (await getCollection('writing'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

const now = Date.now();
const upcoming = (await getCollection('events'))
  .filter(e => e.data.status !== 'past' && e.data.date.getTime() >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 4);

const recentPast = (await getCollection('events'))
  .filter(e => e.data.status === 'past' || e.data.date.getTime() < now)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  jobTitle: 'Head of AI · Cornell Data Scientist in Residence · Forbes contributor',
  description: "Lutz Finger builds AI products and teaches leaders how to ship them. Head of AI at Zoovu, Data Scientist in Residence at Cornell, Forbes contributor, Venture Partner at Cherry Ventures. Two founder exits. Ex-Google, ex-LinkedIn, ex-Snap.",
  knowsAbout: ['Artificial Intelligence', 'AI Workflows', 'Generative Engine Optimization',
               'Large Language Models', 'AI in E-commerce', 'AI in Healthcare', 'AI in Education',
               'Data Products', 'AI Product Management'],
  sameAs: [SITE.social.forbes, SITE.social.linkedin, SITE.social.x,
           SITE.social.youtube, SITE.social.instagram],
};
---
<Base jsonLd={personJsonLd}>
  <section class="hero">
    <h1 class="hero-title">AI isn't the future. Shipping it is.</h1>
    <p class="hero-sub">
      I help people turn AI from a headline into a product. I write the
      <a href={SITE.social.forbes} rel="noopener">Forbes column on AI</a>,
      teach the <a href="/ecornell/">Cornell AI certificate</a> taken by
      thousands of operators, and run
      <a href="/keynote/">a live keynote series</a> with the people actually
      shipping it — Aneesh Chopra, Richard Socher, Lila Tretikov, Martín Casado,
      Lucilla Sioli, and more.
    </p>
    <p>
      Two founder exits, ex-Google, ex-LinkedIn, ex-Snap. These days I focus on
      <strong>AI workflows</strong>, <strong>Generative Engine Optimization</strong>,
      and AI in e-commerce, healthcare, and education — plus the data moats
      behind them.
    </p>
  </section>

  {writing.length > 0 && (
    <section class="section">
      <div class="section-eyebrow">Latest writing</div>
      <ul class="card-list">
        {writing.map(post => (
          <li>
            <a class="card" href={post.data.url} target="_blank" rel="noopener">
              <div class="card-meta">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                <span class={`tag tag-${post.data.source.toLowerCase()}`}>{post.data.source}</span>
              </div>
              <h3 class="card-title">{post.data.title}</h3>
              {post.data.excerpt && <p class="card-excerpt">{post.data.excerpt}</p>}
            </a>
          </li>
        ))}
      </ul>
      <p style="margin-top:1.5rem"><a href="/writing/">All writing →</a></p>
    </section>
  )}

  {upcoming.length > 0 && (
    <section class="section">
      <div class="section-eyebrow">Upcoming</div>
      <ul class="card-list">
        {upcoming.map(ev => (
          <li>
            <a class="card" href={ev.data.url ?? '/speaking/'} target={ev.data.url ? '_blank' : undefined} rel={ev.data.url ? 'noopener' : undefined}>
              <div class="card-meta">
                <time datetime={ev.data.date.toISOString()}>
                  {ev.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                <span class={`tag tag-${ev.data.tag}`}>{ev.data.tag}</span>
                {ev.data.location && <span>· {ev.data.location}</span>}
              </div>
              <h3 class="card-title">{ev.data.title}</h3>
            </a>
          </li>
        ))}
      </ul>
      <p style="margin-top:1.5rem"><a href="/speaking/">Full calendar →</a></p>
    </section>
  )}

  <section class="section">
    <div class="section-eyebrow">Work with me</div>
    <ul style="list-style:none; padding:0">
      <li style="margin-bottom:0.8rem">🎤 <a href="/keynote/"><strong>Be a guest on the Keynote.</strong></a> The live series on what's actually working in AI.</li>
      <li style="margin-bottom:0.8rem">🛠 <a href="/workshop/"><strong>Three-hour AI Agent workshops.</strong></a> Personal-productivity or production-grade. Hosted by eCornell.</li>
      <li style="margin-bottom:0.8rem">🎓 <a href="/ecornell/"><strong>The Cornell certificate.</strong></a> Five courses on designing and building AI solutions.</li>
      <li style="margin-bottom:0.8rem">💬 <a href="/qa/"><strong>Q&A.</strong></a> Common questions, answered from my Forbes column and writing.</li>
      <li style="margin-bottom:0.8rem">📘 <a href="/book/"><strong>Ask, Measure, Learn.</strong></a> The book on using data to learn.</li>
      <li style="margin-bottom:0.8rem">✉️ <a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
    </ul>
  </section>
</Base>
