---
import Base from '~/layouts/Base.astro';
import { SITE } from '~/consts';
import { getCollection } from 'astro:content';

// All keynote-tagged events become the past-guest catalogue.
const events = (await getCollection('events'))
  .filter(e => e.data.tag === 'live-stream' || e.data.tag === 'keynote')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const now = Date.now();
const upcoming = events.filter(e => e.data.date.getTime() >= now && e.data.status !== 'past');
const past = events.filter(e => e.data.date.getTime() < now || e.data.status === 'past');

// Extract guest names from titles ("Title — with Guest Name")
function guestFromTitle(t: string): string | null {
  const m = t.match(/— with (.+)$/);
  return m ? m[1].trim() : null;
}

const seriesJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EventSeries',
  name: 'The Keynote on AI from eCornell',
  description: 'A live keynote series hosted by Lutz Finger at eCornell. Conversations with leaders actually shipping AI — from former US CTO Aneesh Chopra to former Salesforce Chief Scientist Richard Socher.',
  organizer: { '@type': 'Organization', name: 'eCornell', url: 'https://ecornell.cornell.edu' },
  host: { '@type': 'Person', name: SITE.author, url: SITE.url },
  url: `${SITE.url}/keynote/`,
};
---
<Base
  title="The Keynote on AI"
  description="Live keynote series with the people actually shipping AI — former US CTO Aneesh Chopra, Richard Socher, Lila Tretikov, Martín Casado, Lucilla Sioli, Benjamin Goertzel, and more. Hosted by Lutz Finger at eCornell."
  jsonLd={seriesJsonLd}
  wide
>
  <h1>The Keynote on AI</h1>
  <p class="hero-sub">
    A live series I host at eCornell with the people actually shipping AI.
    Honest conversations — what's working, what isn't, and what to do about it.
  </p>

  <section style="margin: 2rem 0">
    <p style="font-size:1.08rem">
      Almost every AI conversation still lives inside software — chatbots,
      copilots, apps. But the next wave of AI value won't ship as an app at
      all. It will show up in molecules, in markets, in workflows, in the way
      organizations actually decide.
    </p>
    <p>
      This series puts you in the room with the people building that next
      wave. Real practitioners. Real decisions. No keynote-deck theater.
      I keep the questions honest — what does "it's working" actually look
      like? Where does the AI earn its keep? — and the conversation moves at
      the pace of a working session, not a press release.
    </p>
    <p>
      Past guests include the <strong>former US CTO</strong>, the
      <strong>former Chief Scientist at Salesforce</strong>, the
      <strong>Head of AI Strategy at NEA</strong>, a
      <strong>general partner at Andreessen Horowitz</strong>, the European
      Commission's <strong>head of AI Policy</strong>, and a
      <strong>founding figure of AGI research</strong>.
    </p>
  </section>

  <h2>Be a guest</h2>
  <p>
    If you're a leader, founder, researcher, or operator with a real story
    about shipping AI — or with a contrarian read on where it's going — I'd
    love to host you. Audiences are Cornell faculty, alumni, students, and
    the public; sessions are live, recorded, and reach a large repeat audience.
  </p>
  <p>
    <a href={`mailto:${SITE.email}?subject=Keynote%20guest`} class="card" style="display:inline-block; padding:0.6rem 1rem; margin-top:0.5rem">
      → Pitch a session: {SITE.email}
    </a>
  </p>

  {upcoming.length > 0 && (
    <section style="margin-top: 3rem">
      <h2>Coming up</h2>
      <ul class="card-list">
        {upcoming.map(ev => (
          <li>
            <a class="card" href={ev.data.url ?? `/speaking/${ev.id}/`} target={ev.data.url ? '_blank' : undefined} rel={ev.data.url ? 'noopener' : undefined}>
              <div class="card-meta">
                <time datetime={ev.data.date.toISOString()}>
                  {ev.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                {guestFromTitle(ev.data.title) && <span>· with {guestFromTitle(ev.data.title)}</span>}
              </div>
              <h3 class="card-title">{ev.data.title.replace(/ — with .+$/, '')}</h3>
              {ev.data.description && <p class="card-excerpt">{ev.data.description}</p>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {past.length > 0 && (
    <section style="margin-top: 3rem">
      <h2>Past guests</h2>
      <ul class="card-list">
        {past.map(ev => {
          const guest = guestFromTitle(ev.data.title);
          const cleanTitle = ev.data.title.replace(/ — with .+$/, '');
          return (
            <li>
              <a class="card" href={ev.data.url ?? `/speaking/${ev.id}/`} target={ev.data.url ? '_blank' : undefined} rel={ev.data.url ? 'noopener' : undefined}>
                <div class="card-meta">
                  <time datetime={ev.data.date.toISOString()}>
                    {ev.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </time>
                  {guest && <span>· <strong>{guest}</strong></span>}
                </div>
                <h3 class="card-title">{cleanTitle}</h3>
                {ev.data.description && <p class="card-excerpt">{ev.data.description}</p>}
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</Base>
