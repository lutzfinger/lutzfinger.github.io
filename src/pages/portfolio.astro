---
import Base from '~/layouts/Base.astro';
import { SITE } from '~/consts';

interface UseCase {
  id: string;
  title: string;
  oneliner: string;
  what: string;
  how: string;
  outcome: string;
  context?: string;
  links?: { label: string; url: string }[];
}

// Order per Lutz: search & discovery first, preventable admissions second,
// social-media analytics last. The rest sit in between.
const CASES: UseCase[] = [
  {
    id: 'search-discovery',
    title: 'AI-driven search & discovery for e-commerce',
    oneliner: "Turn a product catalog into a conversation that ends in 'this is the one'.",
    what: 'R2Decide replaced keyword-and-facet search with intent-aware, conversational discovery. The shopper says what they want in natural language; the system surfaces the right product, configured, with reasons.',
    how: 'Fine-tuned models per category, vector retrieval over enriched catalog embeddings, intent classification, attribute extraction, and re-ranking with a learned reward model trained on real conversions.',
    outcome: 'R2Decide acquired in 2026. The thesis, eval data is the moat, not the model, became the through-line of my Forbes column and informs the AI work I lead at OMMAX.',
    links: [
      { label: 'Acquisition: XGen AI acquires R2Decide', url: 'https://finance.yahoo.com/news/xgen-ai-acquires-r2decide-accelerate-140000212.html' },
      { label: 'Good Search, YouTube', url: 'https://www.youtube.com/playlist?list=PLvA3eJyk5_mBns3etiHk0jI8zvaugeef9' },
      { label: 'AI in Ecommerce, eCornell keynote', url: 'https://ecornell.cornell.edu/keynotes/view/K100324/' },
      { label: 'GEO Playbook for Online Retailers, Forbes', url: 'https://www.forbes.com/sites/lutzfinger/2025/08/20/generative-engine-optimization-geo-a-playbook-for-online-retailers/' },
      { label: 'Age Of AI Driven E-Commerce, Forbes', url: 'https://www.forbes.com/sites/lutzfinger/2026/05/23/three-mistakes-brands-make-in-the-age-of-ai-driven-e-commerce/' },
    ],
  },
  {
    id: 'preventable-admissions',
    title: 'Predicting preventable hospital admissions',
    oneliner: "Flag patients heading toward a preventable admission before it happens.",
    what: 'Models that consume claims, EHR, and behavioral signals to identify patients likely to be admitted to a hospital for something a preceding intervention could have prevented, and surface the intervention.',
    how: 'Time-series features over claims and labs, structured-text features over notes, and a calibrated risk score. Cohort framing is value-based care: rather than predict any admission, predict the avoidable ones, where the model output ties to a concrete action.',
    outcome: 'Sits at the intersection of value-based care and the predictive-analytics thesis I have argued in Forbes, that healthcare AI lives or dies on data-quality discipline, not model size.',
    links: [
      { label: 'Marpai announces VBC', url: 'https://www.prnewswire.com/news-releases/marpai-launches-marpai-connect-platform-to-predict-and-help-modify-risk-in-healthcare-301836763.html' },
      { label: 'Three Trends, AI + Value-Based Care (VBC), Forbes', url: 'https://www.forbes.com/sites/lutzfinger/2023/05/01/three-trends-of-transformation-how-ai--value-based-care-vbc-will-drive-transformation-of-self-insured-healthcare/' },
      { label: 'Changing Healthcare - A Platform Approach Using Data & AI, Forbes', url: 'https://www.forbes.com/sites/lutzfinger/2023/07/05/changing-healthcarea-platform-approach-using-data--ai/' },
    ],
  },
  {
    id: 'cloning-influencers',
    title: 'Cloning influencers, answering in someone\'s voice',
    oneliner: "Train a system on a person's published corpus; answer in their voice with citations.",
    what: 'A system that ingests everything a public figure has written and said, articles, transcripts, talks, social posts, then answers new questions in their voice, with the original source attached.',
    how: 'Embed and structure the corpus. For each question, retrieve relevant passages, score by lexical overlap with the question, and select the sentences a human would actually quote. Always cite the source URL inline.',
    outcome: 'Powers the live Q&A on this site. Built as an advisor-style tool, see the demo I shared on LinkedIn.',
    links: [
      { label: 'Clone-Advisor demo on LinkedIn', url: 'https://www.linkedin.com/posts/lutzfinger_clone-advisor-form-share-7178902812364292096-GSIv/' },
    ],
  },
  {
    id: 'decent-espresso-derek',
    title: 'Decent Espresso "Derek", community Q&A and customer-care bot',
    oneliner: "A 24/7 community concierge for one of the most technical hardware communities online.",
    what: "Derek is a Q&A and customer-care bot for the Decent Espresso community. He answers user questions about machines, shot profiles, firmware, and troubleshooting, drawing from the community's accumulated knowledge so John Buckman and the power users don't have to repeat themselves.",
    how: "Ingest the community's corpus, Facebook group posts, the wiki, profile docs, video transcripts, manuals. Embed and structure. For each question, retrieve the highest-utility prior answers and stitch them into a single response with citations back to the source posts.",
    outcome: "Demonstrates the community-as-corpus pattern: a niche hardware community generates more accurate Q&A from its own archive than any general-purpose model can offer. Same retrieval architecture as the influencer-cloning case, applied to a community instead of a person.",
    links: [
      { label: 'Decent Espresso community thread', url: 'https://www.facebook.com/groups/decentespresso/posts/2591986014318607/' },
    ],
  },
  {
    id: 'virtual-teacher',
    title: 'Virtual Teacher, flip the classroom',
    oneliner: "Make the teacher 24/7 part of every student's conversation, not a one-way lecture.",
    what: "Replaces the broadcast-style lecture with an always-on tutor that joins each student's flow. The teacher's voice, knowledge, and pedagogy, available on demand, inside the student's own work.",
    how: "Train on the teacher's actual material: course videos, transcripts, slides, prior Q&A. For each student question, retrieve the relevant teaching moment and reformulate it the way the teacher would, Socratic prompts, scaffolded hints, deliberate gaps, not just the direct answer.",
    outcome: "A flipped classroom that actually works. The lecture moves to the AI; class time goes to application and discussion. Built and demoed inside the Cornell eCornell certificate as the AI Teaching Assistant pattern.",
    links: [
      { label: 'Cornell transforms generative AI education (with help from a cloned professor)', url: 'https://news.cornell.edu/stories/2024/06/cornell-transforms-generative-ai-education-help-cloned-professor' },
      { label: 'Demo video (YouTube)', url: 'https://www.youtube.com/watch?v=DBOYn778l4I' },
      { label: 'Cornell certificate', url: '/ecornell/' },
    ],
  },
  {
    id: 'sai',
    title: 'SAI, a thin personal AI client',
    oneliner: "A daily-driver AI assistant built on top of Anthropic's Claude.",
    what: "My own personal assistant. A thin client on Anthropic's Claude with workflow skills, scheduled tasks, and tight integrations into my email, calendar, and writing pipeline. Think 'Claude with my muscle memory'.",
    how: "Skill-based architecture: each capability is a small, composable skill (process an incoming email, add a calendar event from a one-liner, sync content into the RAG, draft a Forbes piece) that the model invokes when relevant. Local-first, structured logs.",
    outcome: 'Drives the SAI@ inbox, emails sent there get classified, calendared, and acknowledged automatically. Also runs the content pipelines that keep this site current. The base architecture is open-sourced.',
    links: [
      { label: 'Repo, SAI base version (GitHub)', url: 'https://github.com/lutzfinger/SAI-baseversion' },
      { label: 'Forbes: The Missing Moat in AI, Your Eval Data', url: 'https://www.forbes.com/sites/lutzfinger/2026/05/26/the-missing-moat-in-ai-your-eval-data/' },
    ],
  },
  {
    id: 'audiobook-summarizer',
    title: 'Audiobook summarizer',
    oneliner: "Compress a non-fiction audiobook into a structured, listenable summary.",
    what: "Turns a 10-hour non-fiction audiobook into a 30-minute structured summary you can actually listen to, keeping the spine of the argument and the strongest evidence, dropping the padding.",
    how: "Transcribe → segment by argumentative beat (not by chapter) → extract claim + supporting evidence per beat → re-narrate with consistent pacing and a learned voice. The hard part isn't the LLM, it's the structural pacing.",
    outcome: 'Working prototype. The lesson: most non-fiction is ~30% argument and ~70% support; the craft is compressing argument while keeping the strongest support.',
    links: [
      { label: 'Prototype audio (Google Drive)', url: 'https://drive.google.com/file/d/10qTSxWIUm52dxAXp85HXVMaD5H8-81eg/view' },
    ],
  },
  {
    id: 'future-me',
    title: 'Predicting "Future Me"',
    oneliner: "Use the LinkedIn graph to predict what someone will be doing in five years.",
    what: "A model that, given a person's LinkedIn profile, predicts their likely next role and trajectory, by matching their pattern to thousands of others who started in the same place.",
    how: "Career-graph traversal across hundreds of millions of LinkedIn profiles. For a given profile, find structurally similar earlier-stage members, then look at where THEY ended up, that is the prediction. The trick is good similarity scoring at scale.",
    outcome: "Featured in Mashable's <em>How LinkedIn Found My Future Self</em> (2014). Demonstrated the principle that for career questions, retrieval-over-people beats forecasting-over-features.",
    context: 'Built during my time at LinkedIn (Director, Data Science).',
    links: [
      { label: "Mashable, How LinkedIn Found My 'Future' Self", url: 'https://mashable.com/archive/linkedin-future-self' },
    ],
  },
  {
    id: 'social-media-analytics',
    title: 'Social-media analytics at scale',
    oneliner: 'Reading the social graph for signal, influence, propaganda, and emerging events.',
    what: 'Fisheye Analytics applied NLP and graph analysis to social-media streams for governments, NGOs, defense agencies, and Fortune 500 brands.',
    how: 'Entity extraction, topic modeling, bot detection, and influence-graph analysis across X/Twitter, Facebook, news, and forums. Pipeline built in the pre-LLM era when this was hard.',
    outcome: 'Sold to Kantar (WPP) in 2013. The data and methods became the spine of my Forbes coverage of bots, deepfakes, and information warfare, and they shaped the framework in <em>Ask, Measure, Learn</em>.',
    context: 'Fisheye Analytics, 2008–2013. Co-founded.',
    links: [
      { label: 'Acquisition: Kantar to acquire Fisheye Analytics', url: 'https://www.wpp.com/en/news/2013/12/kantar-to-acquire-fisheye-analytics' },
      { label: 'Book, Ask, Measure, Learn', url: '/book/' },
      { label: "Forbes: Do Evil, the business of social media bots", url: 'https://www.forbes.com/sites/lutzfinger/2015/02/17/do-evil-the-business-of-social-media-bots/' },
    ],
  },
];

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: "Lutz Finger, AI portfolio in use cases",
  itemListElement: CASES.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'CreativeWork',
      name: c.title,
      description: c.oneliner,
      url: `${SITE.url}/portfolio/#${c.id}`,
      creator: { '@type': 'Person', name: SITE.author, url: SITE.url },
    },
  })),
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Portfolio', item: `${SITE.url}/portfolio/` },
  ],
};
---
<Base
  title="Portfolio | AI Use Cases Lutz Finger Has Built and Sold"
  description="Lutz Finger's AI portfolio in use cases, search & discovery for e-commerce, preventable-admissions prediction, cloning influencers, Decent Espresso 'Derek' community bot, the Virtual Teacher pattern, the SAI personal client, audiobook summarization, the LinkedIn 'Future Me' model, and social-media analytics at scale."
  jsonLd={[itemListJsonLd, breadcrumbJsonLd]}
  wide
>
  <h1>Portfolio</h1>
  <p class="hero-sub">
    The AI use cases I've built or am building.
  </p>

  <ul class="card-list portfolio-list">
    {CASES.map(c => (
      <li id={c.id}>
        <article class="card portfolio-card">
          {c.context && (
            <div class="card-meta" style="color:var(--c-text-muted)">{c.context}</div>
          )}
          <h2 class="card-title portfolio-title"><a class="portfolio-permalink" href={`#${c.id}`}>{c.title}</a></h2>
          <p class="portfolio-oneliner">{c.oneliner}</p>
          <p><strong>What it does.</strong> {c.what}</p>
          <p><strong>How it works.</strong> {c.how}</p>
          <p><strong>Outcome.</strong> <span set:html={c.outcome} /></p>
          {c.links && c.links.length > 0 && (
            <p class="portfolio-links">
              {c.links.map((l, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={l.url} rel="noopener" target={l.url.startsWith('http') ? '_blank' : undefined}>{l.label}</a>
                </>
              ))}
            </p>
          )}
        </article>
      </li>
    ))}
  </ul>

  <p style="margin-top:3rem; color:var(--c-text-muted)">
    Working on something AI-shaped where one of these would help?
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
  </p>
</Base>

<style>
  .portfolio-list { gap: 1.5rem; }
  /* Anchor jumps (e.g. /portfolio/#sai) land below the sticky header */
  .portfolio-list > li { scroll-margin-top: 5rem; }
  .portfolio-card { padding: 1.5rem 1.75rem; }
  .portfolio-card p { margin: 0.45em 0; }
  .portfolio-title { margin: 0.2rem 0 0; font-size: 1.32rem; line-height: 1.25; }
  /* Title doubles as a "link to this card" permalink; looks like plain text until hover */
  .portfolio-permalink { color: inherit; text-decoration: none; }
  .portfolio-permalink:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .portfolio-oneliner {
    font-style: italic;
    color: var(--c-text-soft);
    margin: 0.4rem 0 0.9rem !important;
  }
  .portfolio-links {
    margin-top: 0.8rem;
    font-family: var(--font-sans);
    font-size: 0.92rem;
  }
  @media (max-width: 640px) {
    .portfolio-card { padding: 1rem 1.1rem; }
    .portfolio-title { font-size: 1.15rem; }
  }
</style>

<script>
  // Click anywhere on a card (other than a real link) to put its #anchor in the URL — a shareable deep link.
  document.querySelector('.portfolio-list')?.addEventListener('click', (e) => {
    const el = e.target instanceof Element ? e.target : null;
    if (!el || el.closest('a, button')) return;        // real links keep working
    if (window.getSelection()?.toString()) return;      // don't hijack text selection
    const li = el.closest('li[id]');
    if (li && li.id) location.hash = li.id;
  });
</script>
