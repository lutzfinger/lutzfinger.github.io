---
import Base from '~/layouts/Base.astro';
import { SITE } from '~/consts';

interface UseCase {
  id: string;
  title: string;
  oneliner: string;
  what: string;       // What it does, in one paragraph
  how: string;        // How it works / the technique
  outcome: string;    // Result, impact, or what it proves
  context?: string;   // Where it ran / who built it
  links?: { label: string; url: string }[];
  status: 'sold' | 'shipping' | 'shipped';
}

const CASES: UseCase[] = [
  {
    id: 'social-media-analytics',
    title: 'Social-media analytics at scale',
    oneliner: 'Reading the social graph for signal — influence, propaganda, and emerging events.',
    what: 'Fisheye Analytics applied NLP and graph analysis to social-media streams for governments, NGOs, defense agencies, and Fortune 500 brands.',
    how: 'Entity extraction, topic modeling, bot detection, and influence-graph analysis across X/Twitter, Facebook, news, and forums. Pipeline built in the pre-LLM era when this was hard.',
    outcome: 'Sold in 2013. The data and methods became the spine of my Forbes coverage of bots, deepfakes, and information warfare.',
    context: 'Fisheye Analytics, 2008–2013. Co-founded.',
    links: [
      { label: 'How to spot social media bots — they are often lonely', url: 'https://www.linkedin.com/pulse/20140618141134-6074593-how-to-spot-social-media-bots' },
      { label: 'Do Evil — the business of social media bots', url: 'https://scholar.google.com/citations?user=tg0FO3wAAAAJ' },
    ],
    status: 'sold',
  },
  {
    id: 'search-discovery',
    title: 'AI-driven search & discovery for e-commerce',
    oneliner: "Turn a product catalog into a conversation that ends in 'this is the one'.",
    what: 'R2Decide and its successors replace keyword-and-facet search with intent-aware, conversational discovery. The shopper says what they want in natural language; the system surfaces the right product, configured, with reasons.',
    how: 'Fine-tuned models per category, vector retrieval over enriched catalog embeddings, intent classification, attribute extraction, and re-ranking with a learned reward model trained on real conversions.',
    outcome: 'R2Decide was sold in 2025. The thesis — eval data is the moat, not the model — became the through-line of my Forbes column and informs the AI work I lead now.',
    context: 'R2Decide (founder, sold 2025) → ongoing work as Head of AI at Zoovu.',
    links: [
      { label: 'Zoovu', url: 'https://zoovu.com' },
      { label: 'GEO Playbook for Online Retailers — Forbes', url: 'https://www.forbes.com/sites/lutzfinger/2025/08/20/generative-engine-optimization-geo-a-playbook-for-online-retailers/' },
      { label: 'Why I sold — After the Gold Rush (eCornell keynote)', url: 'https://ecornell.cornell.edu/keynotes/overview/K102125/' },
    ],
    status: 'sold',
  },
  {
    id: 'cloning-influencers',
    title: 'Cloning influencers — answering in someone\'s voice',
    oneliner: "Train a system on a person's published corpus; answer in their voice with citations.",
    what: 'A system that ingests everything a public figure has written and said — articles, transcripts, talks, social posts — then answers new questions in their voice, with the original source attached.',
    how: 'Embed and structure the corpus. For each question, retrieve relevant passages, score by lexical overlap with the question, and select the sentences a human would actually quote. Always cite the source URL inline.',
    outcome: 'Powers the live Q&A on this site — every answer is mine, drawn from my Forbes column, LinkedIn writing, book, and Cornell course material.',
    context: 'Built on top of the same RAG pipeline that I open-sourced as the public MCP endpoint.',
    links: [
      { label: 'See it live (this site)', url: '/qa/' },
    ],
    status: 'shipping',
  },
  {
    id: 'audiobook-summarizer',
    title: 'Audiobook summarizer',
    oneliner: "Compress a non-fiction audiobook into a structured, listenable summary.",
    what: "Turns a 10-hour non-fiction audiobook into a 30-minute structured summary you can actually listen to — keeping the spine of the argument and the strongest evidence, dropping the padding.",
    how: "Transcribe → segment by argumentative beat (not by chapter) → extract claim + supporting evidence per beat → re-narrate with consistent pacing and a learned voice. The hard part isn't the LLM, it's the structural pacing.",
    outcome: "A personal-productivity tool that turned out to teach me something useful: most non-fiction books are ~30% argument and ~70% support. Compressing the argument while keeping the strongest support is a real craft.",
    status: 'shipping',
  },
  {
    id: 'preventable-admissions',
    title: 'Predicting preventable hospital admissions',
    oneliner: "Flag patients heading toward a preventable admission before it happens.",
    what: 'Models that consume claims, EHR, and behavioral signals to identify patients likely to be admitted to a hospital for something a preceding intervention could have prevented — and surface the intervention.',
    how: 'Time-series features over claims and labs, structured-text features over notes, and a calibrated risk score. Cohort framing is value-based care: rather than predict any admission, predict the avoidable ones, where the model output ties to a concrete action.',
    outcome: 'Sits at the intersection of value-based care and the predictive-analytics thesis I have argued in Forbes — that healthcare AI lives or dies on data-quality discipline, not model size.',
    links: [
      { label: "Healthcare's AI Lesson: Autocomplete Isn't Understanding — Forbes", url: 'https://www.forbes.com/sites/lutzfinger/2024/05/02/healthcares-ai-lesson-autocomplete-isnt-understanding/' },
      { label: 'Healthcare and Data — How To Measure Quality', url: 'https://www.forbes.com/sites/lutzfinger/2023/06/27/healthcare-and-datahow-to-measure-quality/' },
    ],
    status: 'shipping',
  },
  {
    id: 'sai',
    title: 'SAI — a thin personal AI client',
    oneliner: "A daily-driver AI assistant built on top of Anthropic's Claude.",
    what: "My own personal assistant. A thin client on Anthropic's Claude with workflow skills, scheduled tasks, and tight integrations into my email, calendar, and writing pipeline. Think 'Claude with my muscle memory'.",
    how: "Skill-based architecture: each capability is a small, composable skill (process an incoming email, add a calendar event from a one-liner, sync content into the RAG, draft a Forbes piece) that the model invokes when relevant. Local-first, with structured logs.",
    outcome: 'Drives the SAI@ inbox — emails sent there get classified, calendared, and acknowledged automatically. Also runs the content pipelines that keep this site current.',
    status: 'shipping',
  },
  {
    id: 'future-me',
    title: 'Predicting "Future Me"',
    oneliner: "Use the LinkedIn graph to predict what someone will be doing in five years.",
    what: "A model that, given a person's LinkedIn profile, predicts their likely next role and trajectory — by matching their pattern to thousands of others who started in the same place.",
    how: "Career-graph traversal across hundreds of millions of LinkedIn profiles. For a given profile, find structurally similar earlier-stage members, then look at where THEY ended up — that is the prediction. The trick is good similarity scoring at scale.",
    outcome: "Featured in Mashable's 'How LinkedIn Found My Future Self' (2014). Demonstrated the principle that for career questions, retrieval-over-people beats forecasting-over-features.",
    context: 'Built during my time at LinkedIn (Director, Data Science).',
    links: [
      { label: "Mashable — How LinkedIn Found My 'Future' Self", url: 'https://mashable.com/archive/linkedin-future-self' },
    ],
    status: 'shipped',
  },
];

interface Role { id: string; title: string; period: string; summary?: string; links?: { label: string; url: string }[]; }
const ROLES_NOW: Role[] = [
  { id: 'zoovu', title: 'Head of AI · Zoovu', period: '2025–present', summary: 'AI-driven product discovery and decision experiences for e-commerce.', links: [{ label: 'Zoovu', url: 'https://zoovu.com' }] },
  { id: 'cornell', title: 'Data Scientist in Residence · Cornell SC Johnson', period: '2023–present', summary: 'Teaches AI strategy + designs the AI Solutions track.', links: [{ label: 'Cornell certificate', url: '/ecornell/' }] },
  { id: 'cherry', title: 'Venture Partner · Cherry Ventures', period: '2024–present', summary: "Europe's premier seed fund.", links: [{ label: 'Cherry Ventures', url: 'https://www.cherry.vc/' }] },
  { id: 'forbes', title: 'Senior Contributor · Forbes', period: '2020–present', summary: '50+ articles on AI products, GEO, healthcare, policy.', links: [{ label: 'Column', url: '/writing/forbes/' }] },
];
const ROLES_PAST: Role[] = [
  { id: 'snap', title: 'Snap Inc.', period: 'past', summary: 'AI / Data leadership.' },
  { id: 'google', title: 'Google', period: 'past', summary: 'AI / Data.' },
  { id: 'linkedin', title: 'LinkedIn — Director, Data Science', period: 'past', summary: 'Data Science leadership; the "Future Me" model above came from here.' },
];

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: "Lutz Finger — portfolio of AI use cases",
  itemListElement: CASES.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.title,
    description: c.oneliner,
  })),
};
---
<Base
  title="Portfolio"
  description="Lutz Finger's AI portfolio in use cases — social-media analytics, search & discovery, cloning influencers, audiobook summarization, preventable-admissions prediction, the SAI personal client, and the LinkedIn 'Future Me' model."
  jsonLd={itemListJsonLd}
  wide
>
  <h1>Portfolio</h1>
  <p class="hero-sub">
    AI by use case — what the problem is, how the system solves it, and what
    it actually produced.
  </p>

  <ul class="card-list" style="margin-top:2rem">
    {CASES.map(c => (
      <li id={c.id}>
        <article class="card" style="padding:1.5rem 1.75rem">
          <div class="card-meta">
            <span class={`tag tag-${c.status === 'sold' ? 'forbes' : 'workshop'}`}>{c.status}</span>
            {c.context && <span style="color:var(--c-text-muted)">· {c.context}</span>}
          </div>
          <h2 class="card-title" style="margin-top:0.5rem; font-size:1.35rem">{c.title}</h2>
          <p style="font-style:italic; color:var(--c-text-soft); margin:0.4rem 0 0.8rem">{c.oneliner}</p>
          <p><strong>What it does.</strong> {c.what}</p>
          <p><strong>How it works.</strong> {c.how}</p>
          <p><strong>Outcome.</strong> {c.outcome}</p>
          {c.links && c.links.length > 0 && (
            <p style="margin-top:0.8rem; font-family:var(--font-sans); font-size:0.92rem">
              {c.links.map((l, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={l.url} rel="noopener" target={l.url.startsWith('http') ? '_blank' : undefined}>{l.label}</a>
                </>
              ))}
            </p>
          )}
        </article>
      </li>
    ))}
  </ul>

  <section style="margin-top: 3.5rem">
    <h2 style="border-bottom:1px solid var(--c-border); padding-bottom:0.4rem; font-family:var(--font-sans); font-size:1rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--c-text-muted)">Where this work happens — now</h2>
    <ul class="card-list" style="margin-top:1.25rem">
      {ROLES_NOW.map(r => (
        <li><article class="card" style="padding:1rem 1.25rem">
          <div class="card-meta"><span>{r.period}</span></div>
          <h3 class="card-title">{r.title}</h3>
          {r.summary && <p style="margin:0.4rem 0 0">{r.summary}</p>}
          {r.links && (
            <p style="margin-top:0.5rem; font-family:var(--font-sans); font-size:0.9rem">
              {r.links.map(l => <a href={l.url} rel="noopener" target={l.url.startsWith('http') ? '_blank' : undefined}>{l.label}</a>)}
            </p>
          )}
        </article></li>
      ))}
    </ul>
  </section>

  <section style="margin-top: 2.5rem">
    <h2 style="border-bottom:1px solid var(--c-border); padding-bottom:0.4rem; font-family:var(--font-sans); font-size:1rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--c-text-muted)">Previously</h2>
    <ul class="card-list" style="margin-top:1.25rem">
      {ROLES_PAST.map(r => (
        <li><article class="card" style="padding:0.9rem 1.25rem">
          <h3 class="card-title" style="font-size:1.05rem">{r.title}</h3>
          {r.summary && <p style="margin:0.3rem 0 0; color:var(--c-text-soft); font-size:0.95rem">{r.summary}</p>}
        </article></li>
      ))}
    </ul>
  </section>

  <p style="margin-top:3rem; color:var(--c-text-muted)">
    Working on something AI-shaped where one of these would help?
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
  </p>
</Base>
