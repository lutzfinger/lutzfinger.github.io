---
import Base from '~/layouts/Base.astro';
import { SITE } from '~/consts';

interface Project {
  id: string;
  title: string;
  tagline: string;
  role: string;
  period: string;
  status: 'sold' | 'shipping' | 'shipped' | 'live' | 'experimental' | 'past';
  category: 'exit' | 'product' | 'experiment' | 'company';
  summary: string;
  links?: { label: string; url: string }[];
}

// Real things I've built. Some sold, some shipping, some experimental.
const PROJECTS: Project[] = [
  // ── EXITS ─────────────────────────────────────────────────────────
  {
    id: 'r2decide',
    title: 'R2Decide',
    tagline: 'AI-driven decision tooling for e-commerce.',
    role: 'Founder',
    period: '2024–2025',
    status: 'sold',
    category: 'exit',
    summary: 'Turned product catalogs into conversational, intent-aware recommendation experiences. Sold in 2025.',
    links: [
      { label: 'After the Gold Rush — eCornell keynote (incl. why I sold)', url: 'https://ecornell.cornell.edu/keynotes/overview/K102125/' },
    ],
  },
  {
    id: 'fisheye',
    title: 'Fisheye Analytics',
    tagline: 'Social-media analytics + bot detection.',
    role: 'Co-founder & CEO',
    period: '2008–2013',
    status: 'sold',
    category: 'exit',
    summary: 'Pioneering analytics for the social era. Customers spanned UN agencies, intelligence/defense, and Fortune 500 brands. Sold in 2013.',
    links: [
      { label: 'Do Evil — the business of social media bots (cited paper)', url: 'https://scholar.google.com/citations?user=tg0FO3wAAAAJ' },
    ],
  },

  // ── REAL THINGS I HAVE BUILT (products, prototypes, agents) ──────
  {
    id: 'search-discovery',
    title: 'Search & Discovery',
    tagline: 'Intent-aware retrieval over catalogs and content.',
    role: 'Designer / builder',
    period: 'ongoing',
    status: 'shipping',
    category: 'product',
    summary: 'Search and product-discovery systems that move past keyword matching to intent inference — what the user is actually trying to do, then pulling the right item, article, or answer from a corpus. The lineage runs from R2Decide into ongoing work at Zoovu and a few side experiments.',
    links: [
      { label: 'Zoovu', url: 'https://zoovu.com' },
      { label: 'GEO Playbook for Online Retailers — Forbes', url: 'https://www.forbes.com/sites/lutzfinger/2025/08/20/generative-engine-optimization-geo-a-playbook-for-online-retailers/' },
    ],
  },
  {
    id: 'cloning-influencers',
    title: 'Cloning Influencers',
    tagline: 'A voice/persona system trained on a public figure\'s own corpus.',
    role: 'Builder',
    period: 'ongoing',
    status: 'experimental',
    category: 'experiment',
    summary: "Started as a 'can I make an AI that sounds like me?' experiment. Now a small system that ingests a person's published work (Forbes, LinkedIn, keynote transcripts, social), embeds and structures it, and answers in their voice with citations. Used to power my own /qa page on this site.",
    links: [
      { label: 'Live demo (this site)', url: '/qa/' },
    ],
  },
  {
    id: 'audiobook-summarizer',
    title: 'Audiobook Summarizer',
    tagline: 'Compresses non-fiction audiobooks into structured, listenable summaries.',
    role: 'Builder',
    period: 'ongoing',
    status: 'experimental',
    category: 'experiment',
    summary: "Listens to an audiobook (or its transcript), extracts the spine of arguments and the supporting evidence, then re-narrates a structured summary you can listen to in a fraction of the time. The interesting bit isn't the LLM — it's getting the chapter-level pacing and 'what was the actual point' right.",
  },
  {
    id: 'preventable-admissions',
    title: 'Predicting Preventable Admissions',
    tagline: 'Healthcare ML to surface patients heading toward a preventable hospital admission.',
    role: 'Builder / advisor',
    period: 'ongoing',
    status: 'experimental',
    category: 'experiment',
    summary: "Models that consume claims, EHR, and behavioral signals to flag patients whose next admission is preventable — and to suggest the intervention. Sits at the intersection of value-based care and predictive analytics that I've covered in Forbes.",
    links: [
      { label: 'Healthcare AI Lesson — Forbes', url: 'https://www.forbes.com/sites/lutzfinger/2024/05/02/healthcares-ai-lesson-autocomplete-isnt-understanding/' },
      { label: 'Healthcare And Data — How To Measure Quality', url: 'https://www.forbes.com/sites/lutzfinger/2023/06/27/healthcare-and-datahow-to-measure-quality/' },
    ],
  },
  {
    id: 'sai',
    title: 'SAI',
    tagline: 'A thin personal client on top of Anthropic Claude.',
    role: 'Builder',
    period: 'ongoing',
    status: 'shipping',
    category: 'experiment',
    summary: "My own daily-driver AI assistant — a thin client on top of Anthropic's Claude with workflow skills, scheduled tasks, and tight integrations into my email, calendar, and writing pipeline. Think 'Claude with my muscle memory.' It's what processes my SAI@ inbox and adds events to my calendar from one-liners.",
  },

  // ── CURRENT OPERATING ROLE & MEDIA ───────────────────────────────
  {
    id: 'zoovu',
    title: 'Head of AI · Zoovu',
    tagline: 'AI-driven product discovery + decision experiences for e-commerce.',
    role: 'Head of AI',
    period: '2025–present',
    status: 'live',
    category: 'company',
    summary: 'Where the eval-data-is-the-moat thesis meets daily production reality. Drives much of my Forbes coverage of GEO and AI-driven commerce.',
    links: [{ label: 'Zoovu', url: 'https://zoovu.com' }],
  },
  {
    id: 'forbes',
    title: 'Forbes column on AI',
    tagline: '50+ articles on AI products, GEO, LLM moats, AI in e-commerce, healthcare, policy.',
    role: 'Senior Contributor',
    period: '2020–present',
    status: 'live',
    category: 'company',
    summary: 'Often-cited pieces: "The Missing Moat In AI: Your Eval Data", "If Your Name Isn\'t Western, AI Could Cost You The Promotion", the GEO playbook series.',
    links: [
      { label: 'Forbes column', url: 'https://www.forbes.com/sites/lutzfinger/' },
      { label: 'On this site', url: '/writing/forbes/' },
    ],
  },
  {
    id: 'cornell-cert',
    title: 'Cornell Certificate — Designing & Building AI Solutions',
    tagline: 'Five online courses + AI Teaching Assistant. Thousands of operators.',
    role: 'Instructor',
    period: '2023–present',
    status: 'live',
    category: 'company',
    summary: '27 guest experts (Aneesh Chopra, Richard Socher, Allen Blue, Igor Perisic, Adrian Monck, Filip Dames, more) record interview segments. Integrated OpenAI-powered TA.',
    links: [
      { label: 'Certificate page', url: 'https://ecornell.cornell.edu/certificates/ai/designing-and-building-ai-solutions/' },
      { label: 'On this site', url: '/ecornell/' },
    ],
  },
  {
    id: 'keynote-series',
    title: 'The Keynote on AI',
    tagline: 'Live series with the people actually shipping AI.',
    role: 'Host & faculty lead',
    period: '2024–present',
    status: 'live',
    category: 'company',
    summary: '15+ live sessions to date — Aneesh Chopra (former US CTO), Martín Casado (a16z), Richard Socher, Lila Tretikov (NEA), Lucilla Sioli (EU Commission), Benjamin Goertzel.',
    links: [{ label: 'On this site', url: '/keynote/' }],
  },
  {
    id: 'cherry',
    title: 'Cherry Ventures — Venture Partner',
    tagline: "Europe's premier seed fund. AI-native company evaluation.",
    role: 'Venture Partner',
    period: '2024–present',
    status: 'live',
    category: 'company',
    summary: 'Helps the team evaluate technical depth and product strategy.',
    links: [{ label: 'Cherry Ventures', url: 'https://www.cherry.vc/' }],
  },
  {
    id: 'book',
    title: 'Ask, Measure, Learn (book)',
    tagline: "O'Reilly, 2014. With Soumitra Dutta.",
    role: 'Co-author',
    period: '2014',
    status: 'shipped',
    category: 'company',
    summary: 'Practical guide to using social and behavioral data to learn fast enough to ship.',
    links: [{ label: 'On this site', url: '/book/' }],
  },

  // ── PAST EMPLOYERS ───────────────────────────────────────────────
  { id: 'linkedin-dir', title: 'LinkedIn — Director, Data Science', tagline: 'Data Science leadership across the platform.', role: 'Director', period: 'past', status: 'past', category: 'company', summary: '' },
  { id: 'snap', title: 'Snap Inc. — AI / Data', tagline: 'Applied ML in a real consumer-product environment.', role: 'AI / Data', period: 'past', status: 'past', category: 'company', summary: '' },
  { id: 'google', title: 'Google — AI / Data', tagline: '', role: 'AI / Data', period: 'past', status: 'past', category: 'company', summary: '' },
];

const groups = {
  'Exits': PROJECTS.filter(p => p.category === 'exit'),
  'Things I have built or am building': PROJECTS.filter(p => p.category === 'product' || p.category === 'experiment'),
  'Current operating roles': PROJECTS.filter(p => p.category === 'company' && p.status === 'live'),
  'Past employers': PROJECTS.filter(p => p.category === 'company' && p.status === 'past'),
  'Book': PROJECTS.filter(p => p.id === 'book'),
};

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: "Lutz Finger — portfolio",
  itemListElement: PROJECTS.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.title,
    description: p.summary || p.tagline,
  })),
};

const statusLabel: Record<string, string> = {
  sold: 'sold',
  shipping: 'shipping',
  shipped: 'shipped',
  live: 'live',
  experimental: 'experimental',
  past: 'past',
};
---
<Base
  title="Portfolio"
  description="Things I've built. Two AI exits. A handful of shipping products and experiments — search & discovery, an influencer-cloning system, an audiobook summarizer, a preventable-admissions model, and SAI (a thin personal client on Claude). Plus current roles at Zoovu, Cornell, Cherry, Forbes."
  jsonLd={itemListJsonLd}
  wide
>
  <h1>Portfolio</h1>
  <p class="hero-sub">
    The things I've actually built. Some sold. Some shipping. Some still
    experimental but real enough to talk about.
  </p>

  {Object.entries(groups).map(([label, items]) => items.length > 0 && (
    <section style="margin: 3rem 0">
      <h2 style="border-bottom:1px solid var(--c-border); padding-bottom:0.4rem; font-family:var(--font-sans); font-size:1rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--c-text-muted)">{label}</h2>
      <ul class="card-list" style="margin-top:1.25rem">
        {items.map(p => (
          <li id={p.id}>
            <article class="card" style="padding:1.3rem 1.5rem">
              <div class="card-meta">
                {p.status !== 'past' && (
                  <span class={`tag tag-${p.status === 'sold' ? 'forbes' : p.status === 'experimental' ? 'podcast' : 'workshop'}`}>{statusLabel[p.status]}</span>
                )}
                <span>· {p.role}</span>
                <span>· {p.period}</span>
              </div>
              <h3 class="card-title" style="margin-top:0.4rem">{p.title}</h3>
              {p.tagline && <p style="font-style:italic; color:var(--c-text-soft); margin:0.3rem 0 0.5rem">{p.tagline}</p>}
              {p.summary && <p style="margin:0.5rem 0 0">{p.summary}</p>}
              {p.links && p.links.length > 0 && (
                <p style="margin-top:0.7rem; font-family:var(--font-sans); font-size:0.92rem">
                  {p.links.map((l, i) => (
                    <>
                      {i > 0 && ' · '}
                      <a href={l.url} rel="noopener" target={l.url.startsWith('http') ? '_blank' : undefined}>{l.label}</a>
                    </>
                  ))}
                </p>
              )}
            </article>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <p style="margin-top:3rem; color:var(--c-text-muted)">
    Working on something AI-shaped? <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
  </p>
</Base>
