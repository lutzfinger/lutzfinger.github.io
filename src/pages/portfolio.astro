---
import Base from '~/layouts/Base.astro';
import { SITE } from '~/consts';

interface Project {
  id: string;
  title: string;
  role: string;
  period: string;
  status: 'sold' | 'active' | 'past' | 'community';
  category: 'company' | 'product' | 'open-source' | 'teaching' | 'media';
  summary: string;
  details: string[];
  links?: { label: string; url: string }[];
}

const PROJECTS: Project[] = [
  // ── COMPANIES BUILT & SOLD ─────────────────────────────────────────────
  {
    id: 'r2decide',
    title: 'R2Decide',
    role: 'Founder',
    period: '2024 – 2025 (sold)',
    status: 'sold',
    category: 'company',
    summary: 'AI-driven decision tooling for e-commerce — turning product catalogs into conversational, intent-aware recommendation experiences.',
    details: [
      'Founded to fix a real gap I saw running e-commerce data science: brands could afford the model but couldn\'t afford to maintain a fine-tuned one per category.',
      'Sold in 2025. The acquirer integrated R2Decide into a broader AI commerce stack.',
      'Selling R2Decide was part of my deliberate shift toward "value where AI meets workflow" — see my Oct 2025 eCornell keynote with Kurt Wagner.',
    ],
    links: [
      { label: 'Why I built (and sold) R2Decide — LinkedIn article', url: 'https://www.linkedin.com/in/lutzfinger/recent-activity/articles/' },
      { label: 'After the Gold Rush — eCornell keynote', url: 'https://ecornell.cornell.edu/keynotes/overview/K102125/' },
    ],
  },
  {
    id: 'fisheye',
    title: 'Fisheye Analytics',
    role: 'Co-founder & CEO',
    period: '2008 – 2013 (sold)',
    status: 'sold',
    category: 'company',
    summary: 'Pioneering social-media analytics and bot detection. One of the earliest companies to apply NLP and graph analysis to social listening for governments, NGOs, and Fortune 500s.',
    details: [
      'Built out of the recognition that social media wasn\'t just a marketing channel — it was a primary signal for influence, propaganda, and emerging events.',
      'Customers spanned UN agencies, intelligence/defense communities, and major consumer brands.',
      'Sold in 2013. Founded the conceptual basis for what later became my Forbes coverage of bots, deepfakes, and information warfare.',
    ],
    links: [
      { label: 'How to spot social media bots — Forbes / LinkedIn article', url: 'https://www.linkedin.com/in/lutzfinger/recent-activity/articles/' },
      { label: 'Do Evil — the business of social media bots', url: 'https://www.linkedin.com/in/lutzfinger/recent-activity/articles/' },
    ],
  },
  // ── CURRENT ────────────────────────────────────────────────────────────
  {
    id: 'zoovu',
    title: 'Head of AI at Zoovu',
    role: 'Head of AI',
    period: '2025 – present',
    status: 'active',
    category: 'company',
    summary: 'Leading the AI function at Zoovu — AI-driven product discovery and decision experiences for e-commerce, on which my Forbes coverage of GEO and AI-driven commerce draws directly.',
    details: [
      'Where the eval-data-is-the-moat thesis meets daily production reality.',
      'Drives several of my Forbes pieces on GEO, AI assistants, and the post-SEO playbook.',
    ],
    links: [
      { label: 'Zoovu', url: 'https://zoovu.com' },
      { label: 'GEO Playbook for Online Retailers — Forbes', url: 'https://www.forbes.com/sites/lutzfinger/2025/08/20/generative-engine-optimization-geo-a-playbook-for-online-retailers/' },
      { label: 'Answer Engine Optimization — What Brands Need To Know', url: 'https://www.forbes.com/sites/lutzfinger/2025/06/19/answer-engine-optimization-aeo--what-brands-need-to-know/' },
    ],
  },
  // ── TEACHING & THOUGHT LEADERSHIP ──────────────────────────────────────
  {
    id: 'ecornell-cert',
    title: 'eCornell Certificate — Designing & Building AI Solutions',
    role: 'Instructor',
    period: '2023 – present',
    status: 'active',
    category: 'teaching',
    summary: "Cornell's flagship AI certificate. Five courses, fully online, integrated with OpenAI — for product leaders, engineers, and analysts who want to ship AI that actually works. No coding required.",
    details: [
      '27 guest experts contribute interview segments — including Aneesh Chopra, Richard Socher, Allen Blue, Igor Perisic, Adrian Monck, Filip Dames.',
      'Notable for an integrated AI Teaching Assistant built on OpenAI.',
    ],
    links: [
      { label: 'Certificate page', url: 'https://ecornell.cornell.edu/certificates/ai/designing-and-building-ai-solutions/' },
      { label: 'On this site', url: '/ecornell/' },
    ],
  },
  {
    id: 'keynote-on-ai',
    title: 'The Keynote on AI — eCornell',
    role: 'Host & faculty lead',
    period: '2024 – present',
    status: 'active',
    category: 'media',
    summary: 'Recurring live keynote series I host for eCornell — guests include Aneesh Chopra (former US CTO), Martín Casado (a16z), Richard Socher, Lila Tretikov (NEA), Lucilla Sioli (EU Commission), and Benjamin Goertzel.',
    details: [
      '15+ live sessions to date, each ~60 minutes with audience Q&A.',
      'Full upcoming schedule and back catalog at /speaking.',
    ],
    links: [
      { label: 'All keynotes', url: 'https://ecornell.cornell.edu/keynotes/' },
      { label: 'On this site', url: '/speaking/' },
    ],
  },
  {
    id: 'workshops-2026',
    title: 'Hands-On AI Agent Workshops',
    role: 'Designer & instructor',
    period: '2026 – present',
    status: 'active',
    category: 'teaching',
    summary: 'Two new 3-hour live workshops — one personal-productivity ("vibe-code your own agent"), one enterprise-grade ("from prototype to production with Claude Code + LangGraph + OWASP LLM Top 10").',
    links: [
      { label: 'Personal productivity workshop', url: 'https://ecornell.cornell.edu/courses/artificial-intelligence/hands-on-ai-agents-vibe-code-ai-workflows-and-agent-skills-for-personal-productivity/' },
      { label: 'Enterprise workshop', url: 'https://ecornell.cornell.edu/courses/artificial-intelligence/building-enterprise-ready-ai-agents-from-prototypes-to-production/' },
    ],
  },
  {
    id: 'forbes-column',
    title: 'Forbes column on AI',
    role: 'Senior Contributor',
    period: '2020 – present',
    status: 'active',
    category: 'media',
    summary: '50+ articles on AI products, GEO, LLM moats, AI in e-commerce and healthcare, AI policy. Often-cited pieces include "The Missing Moat in AI" (eval data) and "If Your Name Isn\'t Western, AI Could Cost You The Promotion."',
    links: [
      { label: 'Forbes column', url: 'https://www.forbes.com/sites/lutzfinger/' },
      { label: 'On this site', url: '/writing/forbes/' },
    ],
  },
  {
    id: 'book-aml',
    title: 'Ask, Measure, Learn (book)',
    role: 'Co-author with Soumitra Dutta',
    period: '2014',
    status: 'past',
    category: 'media',
    summary: "O'Reilly book on using social and behavioral data to learn fast enough to ship. Co-authored with then-Cornell Johnson Dean (now Saïd Oxford Dean) Soumitra Dutta.",
    links: [
      { label: 'On this site', url: '/book/' },
      { label: "O'Reilly", url: 'https://www.oreilly.com/library/view/ask-measure-learn/9781449373047/' },
    ],
  },
  // ── ADVISORY & VENTURE ─────────────────────────────────────────────────
  {
    id: 'cherry',
    title: 'Cherry Ventures',
    role: 'Venture Partner',
    period: '2024 – present',
    status: 'active',
    category: 'company',
    summary: "Venture Partner at Cherry Ventures — Europe's premier seed fund. Focused on AI-native companies; helps the team evaluate technical depth and product strategy.",
    links: [{ label: 'Cherry Ventures', url: 'https://www.cherry.vc/' }],
  },
  // ── BROADER FOOTPRINT ──────────────────────────────────────────────────
  {
    id: 'linkedin-dir',
    title: 'LinkedIn — Director of Data Science',
    role: 'Director, Data Science',
    period: 'past',
    status: 'past',
    category: 'company',
    summary: 'Data Science leadership at LinkedIn — work spanning the social graph, recommendations, and the data pipelines behind the platform\'s core surfaces.',
  },
  {
    id: 'snap',
    title: 'Snap Inc.',
    role: 'AI / Data leadership',
    period: 'past',
    status: 'past',
    category: 'company',
    summary: 'AI and data leadership at Snap — applied ML in a real consumer-product environment.',
  },
  {
    id: 'google',
    title: 'Google',
    role: 'AI / Data',
    period: 'past',
    status: 'past',
    category: 'company',
    summary: 'AI and data work inside Google.',
  },
];

const groups: Record<string, Project[]> = {
  'Companies (founder)': PROJECTS.filter(p => p.category === 'company' && (p.status === 'sold' || p.id === 'cherry')),
  'Current operating role': PROJECTS.filter(p => p.id === 'zoovu'),
  'Teaching & live content': PROJECTS.filter(p => p.category === 'teaching' || p.category === 'media'),
  'Past employers': PROJECTS.filter(p => p.status === 'past' && p.category === 'company'),
};

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: "Lutz Finger — portfolio",
  itemListElement: PROJECTS.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.title,
    description: p.summary,
  })),
};
---
<Base
  title="Portfolio"
  description="What Lutz Finger has built — two AI exits (R2Decide 2025, Fisheye Analytics 2013), current Head of AI at Zoovu, Cornell teaching, Forbes column, the eCornell certificate, and the live keynote series."
  jsonLd={itemListJsonLd}
  wide
>
  <h1>Portfolio</h1>
  <p class="hero-sub">
    What I've built. Two AI exits. A current operating role. Teaching at Cornell.
    A Forbes column. And a live keynote series with guests who actually ship AI.
  </p>

  {Object.entries(groups).map(([label, items]) => items.length > 0 && (
    <section style="margin: 3rem 0">
      <h2 style="border-bottom: 1px solid var(--c-border); padding-bottom: 0.4rem; margin-bottom: 1.25rem; font-family: var(--font-sans); font-size: 1rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--c-text-muted)">{label}</h2>
      <ul class="card-list">
        {items.map(p => (
          <li id={p.id}>
            <article class="card" style="padding: 1.4rem 1.5rem">
              <div class="card-meta">
                <span><strong>{p.role}</strong></span>
                <span>·</span>
                <span>{p.period}</span>
                {p.status === 'sold' && <><span>·</span><span class="tag tag-forbes">sold</span></>}
                {p.status === 'active' && <><span>·</span><span class="tag tag-workshop">active</span></>}
              </div>
              <h3 class="card-title" style="margin-top: 0.4rem">{p.title}</h3>
              <p style="margin: 0.6rem 0 0.4rem">{p.summary}</p>
              {p.details && (
                <ul style="margin-top: 0.6rem">
                  {p.details.map(d => <li>{d}</li>)}
                </ul>
              )}
              {p.links && p.links.length > 0 && (
                <p style="margin-top: 0.6rem; font-size: 0.92rem; font-family: var(--font-sans)">
                  {p.links.map((l, i) => (
                    <>
                      {i > 0 && ' · '}
                      <a href={l.url} rel="noopener" target={l.url.startsWith('http') ? '_blank' : undefined}>{l.label}</a>
                    </>
                  ))}
                </p>
              )}
            </article>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <p style="margin-top: 3rem; color: var(--c-text-muted); font-size: 0.9rem">
    Working on something AI-shaped where any of the above might be useful? <a href={`mailto:${SITE.email}`}>Get in touch</a>.
  </p>
</Base>
