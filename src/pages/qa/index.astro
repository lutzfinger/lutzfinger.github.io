---
import Base from '~/layouts/Base.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('qa'))
  .sort((a, b) => a.data.question.localeCompare(b.data.question));

// Tag taxonomy with display labels.
const TAG_LABELS: Record<string, string> = {
  'search-geo': 'Search & GEO',
  'llm-moats': 'LLM Moats',
  'healthcare': 'Healthcare',
  'ecommerce': 'E-commerce',
  'ai-product': 'AI Product',
  'ai-workflows': 'AI Workflows',
  'policy-ethics': 'Policy & Ethics',
  'measurement': 'Measurement',
  'analytics': 'Analytics',
  'bias': 'Bias',
  'risks': 'Risks',
  'education': 'Education',
  'startup': 'Startups',
  'investment': 'Investment',
  'leadership': 'Leadership',
  'future-of-work': 'Future of Work',
};

const tagCounts: Record<string, number> = {};
for (const it of items) {
  for (const t of it.data.tags) tagCounts[t] = (tagCounts[t] ?? 0) + 1;
}
const orderedTags = Object.keys(TAG_LABELS).filter(t => tagCounts[t] > 0);

const faqJsonLd = items.length === 0 ? undefined : {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map(i => ({
    '@type': 'Question',
    name: i.data.question,
    acceptedAnswer: { '@type': 'Answer', text: i.body ?? '' },
  })),
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.lutzfinger.com' },
    { '@type': 'ListItem', position: 2, name: 'Q&A', item: 'https://www.lutzfinger.com/qa/' },
  ],
};
---
<Base
  title="Q&A"
  description={`Answers to ${items.length} questions about AI, search, GEO, LLM moats, healthcare, e-commerce, policy, and more, sourced from Lutz Finger's writing and teaching.`}
  jsonLd={faqJsonLd ? [faqJsonLd, breadcrumbJsonLd] : breadcrumbJsonLd}
  wide
>
  <h1>Q&amp;A</h1>

  <div class="filters qa-tag-row">
    <a href="/qa/" class="filter-chip active">All ({items.length})</a>
    {orderedTags.map(t => (
      <a href={`/qa/tag/${t}/`} class="filter-chip">{TAG_LABELS[t]} ({tagCounts[t]})</a>
    ))}
  </div>

  <ul class="card-list" style="margin-top:2rem">
    {items.map(item => (
      <li>
        <a class="card" href={`/qa/${item.id}/`}>
          <div class="card-meta qa-tags-meta">
            {item.data.tags.slice(0, 3).map(t => (
              <span class="tag-mini">{TAG_LABELS[t] ?? t}</span>
            ))}
          </div>
          <h3 class="card-title">{item.data.question}</h3>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .qa-tag-row { gap: 0.35rem; }
  .qa-tag-row .filter-chip { font-size: 0.78rem; padding: 0.2em 0.65em; }
  .qa-tags-meta { gap: 0.3rem; }
  .tag-mini {
    display: inline-block;
    padding: 0.05em 0.5em;
    background: var(--c-bg-soft);
    border-radius: 3px;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--c-text-soft);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
