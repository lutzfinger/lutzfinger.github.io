---
import Base from '~/layouts/Base.astro';
import { getCollection, render } from 'astro:content';

const items = (await getCollection('qa'))
  .sort((a, b) => a.data.question.localeCompare(b.data.question));

const rendered = await Promise.all(items.map(async item => {
  const { Content } = await render(item);
  return { item, Content };
}));

const faqJsonLd = items.length === 0 ? undefined : {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map(i => ({
    '@type': 'Question',
    name: i.data.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: i.body ?? '',
    },
  })),
};

const categories = [...new Set(items.map(i => i.data.category).filter(Boolean))] as string[];
---
<Base
  title="Q&A"
  description={`Answers to ${items.length} questions about AI, search, generative engine optimization, and product strategy — drawn from Lutz Finger's writing.`}
  jsonLd={faqJsonLd}
>
  <h1>Q&amp;A</h1>
  <p class="hero-sub">
    Common questions, answered from my own writing. Generated by retrieval over
    every Forbes article and LinkedIn post, then edited.
    Want to ask your own? Hit <a href={`mailto:hello@lutzfinger.com`}>hello@lutzfinger.com</a> —
    a live chat widget is coming.
  </p>

  {items.length === 0 ? (
    <p><em>The Q&amp;A is being generated from the article archive. Check back shortly.</em></p>
  ) : (
    <>
      {categories.length > 0 && (
        <div class="filters">
          {categories.map(c => (
            <a href={`#cat-${c.toLowerCase().replace(/\s+/g, '-')}`} class="filter-chip">{c}</a>
          ))}
        </div>
      )}

      {rendered.map(({ item, Content }) => (
        <section id={item.data.category ? `cat-${item.data.category.toLowerCase().replace(/\s+/g, '-')}` : undefined}>
          <h2 class="qa-question">{item.data.question}</h2>
          <div class="qa-answer"><Content /></div>
          {item.data.sources.length > 0 && (
            <div class="qa-sources">
              Sources: {item.data.sources.map((s, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={s.url}>{s.title}</a>
                </>
              ))}
            </div>
          )}
        </section>
      ))}
    </>
  )}
</Base>
