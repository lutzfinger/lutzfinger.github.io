---
import { getCollection, render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import { SITE } from '~/consts';

export async function getStaticPaths() {
  const all = await getCollection('events');
  return all.map(entry => ({
    params: { slug: entry.id },
    props: { entry, all },
  }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const isoStart = d.date.toISOString();
const isoEnd = d.endDate?.toISOString();
const dateLabel = d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Pull guest name out of the title if present ("Title, with Guest Name").
const guestMatch = d.title.match(/,\s*with\s+(.+)$/i);
const guest = guestMatch ? guestMatch[1].trim() : null;
const cleanTitle = d.title.replace(/,\s*with\s+.+$/i, '');

// Other sessions: same tag, sorted by date, exclude self.
const others = all
  .filter(e => e.id !== entry.id && e.data.tag === d.tag)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const eventJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: d.title,
  startDate: isoStart,
  eventAttendanceMode: ({
    offline: 'https://schema.org/OfflineEventAttendanceMode',
    online: 'https://schema.org/OnlineEventAttendanceMode',
    mixed: 'https://schema.org/MixedEventAttendanceMode',
  })[d.eventAttendanceMode],
  eventStatus: d.status === 'cancelled'
    ? 'https://schema.org/EventCancelled'
    : 'https://schema.org/EventScheduled',
  performer: { '@type': 'Person', name: SITE.author, url: SITE.url },
};
if (isoEnd) eventJsonLd.endDate = isoEnd;
if (d.location) eventJsonLd.location = { '@type': 'Place', name: d.location };
if (d.organizer) eventJsonLd.organizer = { '@type': 'Organization', name: d.organizer };
if (d.url) eventJsonLd.url = d.url;
if (d.description) eventJsonLd.description = d.description;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Speaking', item: `${SITE.url}/speaking/` },
    { '@type': 'ListItem', position: 3, name: cleanTitle },
  ],
};

const titleForHead = `${cleanTitle}${guest ? ', with ' + guest : ''} | Lutz Finger`;
const descForHead = d.description
  ?? `${cleanTitle}${guest ? ' with ' + guest : ''}, ${dateLabel}. ${d.tag.replace(/-/g,' ')} hosted by Lutz Finger${d.organizer ? ' at ' + d.organizer : ''}.`;
---
<Base
  title={titleForHead}
  description={descForHead}
  type="article"
  jsonLd={[eventJsonLd, breadcrumbJsonLd]}
>
  <p style="margin-bottom:1rem"><a href="/speaking/">← All speaking</a></p>

  <article>
    <h1>{cleanTitle}</h1>
    {guest && (
      <p style="font-size:1.15rem; color:var(--c-text-soft); margin:0.4rem 0 1rem">
        with <strong>{guest}</strong>
      </p>
    )}
    <div class="article-meta">
      <time datetime={isoStart}>{dateLabel}</time>
      <span>·</span>
      <span class={`tag tag-${d.tag}`}>{d.tag}</span>
      {d.location && <><span>·</span><span>{d.location}</span></>}
      {d.organizer && <><span>·</span><span>{d.organizer}</span></>}
    </div>

    <div class="article-body">
      <Content />
    </div>

    {d.url && (
      <aside class="article-source">
        <strong>Event link:</strong> <a href={d.url} rel="noopener" target={d.url.startsWith('http') ? '_blank' : undefined}>{d.url}</a>
      </aside>
    )}

    <section style="margin-top:2.5rem; padding:1.25rem 1.5rem; border:1px solid var(--c-border); border-radius:6px; background:var(--c-bg-soft)">
      <p style="margin:0; font-size:0.95rem">
        <strong>About the speaker.</strong>
        Lutz Finger is Head of AI at <a href="https://zoovu.com" rel="noopener">Zoovu</a>,
        Data Scientist in Residence at Cornell SC Johnson,
        and a <a href={SITE.social.forbes} rel="noopener">Forbes contributor</a>.
        Two AI exits. Ex-Google, ex-LinkedIn, ex-Snap.
        For booking inquiries: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </section>

    {others.length > 0 && (
      <section style="margin-top:3rem">
        <h2 style="border-bottom:1px solid var(--c-border); padding-bottom:0.4rem; font-family:var(--font-sans); font-size:1rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--c-text-muted)">Other {d.tag.replace(/-/g, ' ')} sessions</h2>
        <ul class="card-list" style="margin-top:1.25rem">
          {others.map(o => {
            const oClean = o.data.title.replace(/,\s*with\s+.+$/i, '');
            const oGuest = o.data.title.match(/,\s*with\s+(.+)$/i)?.[1]?.trim();
            return (
              <li>
                <a class="card" href={`/speaking/${o.id}/`} style="padding:0.85rem 1.15rem">
                  <div class="card-meta" style="margin-bottom:0.2rem">
                    <time datetime={o.data.date.toISOString()}>{o.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
                    {oGuest && <><span>·</span><span>with {oGuest}</span></>}
                  </div>
                  <h3 class="card-title" style="font-size:1.02rem; margin:0">{oClean}</h3>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}
  </article>
</Base>
