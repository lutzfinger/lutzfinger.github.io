---
import Base from '~/layouts/Base.astro';
import { SITE } from '~/consts';
import { getCollection } from 'astro:content';

const now = Date.now();
const all = await getCollection('events');
const upcoming = all
  .filter(e => e.data.status !== 'past' && e.data.date.getTime() >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const past = all
  .filter(e => e.data.status === 'past' || e.data.date.getTime() < now)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const upcomingJsonLd = upcoming.length === 0 ? undefined : upcoming.map(e => ({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: e.data.title,
  startDate: e.data.date.toISOString(),
  ...(e.data.endDate && { endDate: e.data.endDate.toISOString() }),
  eventAttendanceMode: ({
    offline: 'https://schema.org/OfflineEventAttendanceMode',
    online: 'https://schema.org/OnlineEventAttendanceMode',
    mixed: 'https://schema.org/MixedEventAttendanceMode',
  })[e.data.eventAttendanceMode],
  eventStatus: 'https://schema.org/EventScheduled',
  location: e.data.location ? { '@type': 'Place', name: e.data.location } : undefined,
  organizer: e.data.organizer ? { '@type': 'Organization', name: e.data.organizer } : undefined,
  performer: { '@type': 'Person', name: SITE.author, url: SITE.url },
  url: e.data.url,
  description: e.data.description,
}));
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Speaking', item: `${SITE.url}/speaking/` },
  ],
};
const allJsonLd = upcomingJsonLd ? [...upcomingJsonLd, breadcrumbJsonLd] : breadcrumbJsonLd;
---
<Base
  title="Speaking"
  description={`Upcoming and past speaking, keynotes, workshops, conference sessions. ${upcoming.length} upcoming, ${past.length} past.`}
  jsonLd={allJsonLd}
  wide
>
  <h1>Speaking</h1>
  <p class="hero-sub">
    Keynotes, workshops, lectures, panels. For bookings:
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
  </p>

  {upcoming.length > 0 ? (
    <section style="margin-top:2rem">
      <h2>Upcoming</h2>
      <ul class="card-list">
        {upcoming.map(e => (
          <li>
            <a class="card" href={e.data.url ?? `/speaking/${e.id}/`} target={e.data.url ? '_blank' : undefined} rel={e.data.url ? 'noopener' : undefined}>
              <div class="card-meta">
                <time datetime={e.data.date.toISOString()}>
                  {e.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                <span class={`tag tag-${e.data.tag}`}>{e.data.tag}</span>
                {e.data.location && <span>· {e.data.location}</span>}
              </div>
              <h3 class="card-title">{e.data.title}</h3>
              {e.data.description && <p class="card-excerpt">{e.data.description}</p>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ) : (
    <p style="margin-top:2rem"><em>No public sessions on the calendar right now.</em></p>
  )}

  {past.length > 0 && (
    <section style="margin-top:3rem">
      <h2 style="border-bottom:1px solid var(--c-border); padding-bottom:0.4rem; font-family:var(--font-sans); font-size:1rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--c-text-muted)">Past sessions</h2>
      <ul class="card-list" style="margin-top:1.25rem">
        {past.map(e => (
          <li>
            <a class="card" href={e.data.url ?? `/speaking/${e.id}/`} target={e.data.url ? '_blank' : undefined} rel={e.data.url ? 'noopener' : undefined}>
              <div class="card-meta">
                <time datetime={e.data.date.toISOString()}>
                  {e.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                <span class={`tag tag-${e.data.tag}`}>{e.data.tag}</span>
                {e.data.location && <span>· {e.data.location}</span>}
              </div>
              <h3 class="card-title">{e.data.title}</h3>
              {e.data.description && <p class="card-excerpt">{e.data.description}</p>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
