---
import Base from '~/layouts/Base.astro';
import { getCollection } from 'astro:content';

const now = Date.now();
const all = await getCollection('events');
const past = all
  .filter(e => e.data.status === 'past' || e.data.date.getTime() < now)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base
  title="Past speaking"
  description={`Archive of past keynotes, workshops, and conference sessions by Lutz Finger — ${past.length} sessions.`}
>
  <h1>Past speaking</h1>
  <p class="hero-sub">{past.length} past sessions.</p>

  {past.length === 0 ? (
    <p><em>Archive is being populated.</em></p>
  ) : (
    <ul class="card-list">
      {past.map(e => (
        <li>
          <a class="card" href={e.data.url ?? `/speaking/${e.id}/`}>
            <div class="card-meta">
              <time datetime={e.data.date.toISOString()}>
                {e.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              <span class={`tag tag-${e.data.tag}`}>{e.data.tag}</span>
              {e.data.location && <span>· {e.data.location}</span>}
            </div>
            <h3 class="card-title">{e.data.title}</h3>
            {e.data.description && <p class="card-excerpt">{e.data.description}</p>}
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>
