---
import { getCollection, render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import { SITE } from '~/consts';

export async function getStaticPaths() {
  const all = await getCollection('transcripts');
  return all.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const iso = d.date.toISOString();
const dateLabel = d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// "Title, with Guest" → clean title + guest (guest may also be in frontmatter).
const guest = d.guest ?? d.title.match(/,\s*with\s+(.+)$/i)?.[1]?.trim() ?? null;
const cleanTitle = d.title.replace(/,\s*with\s+.+$/i, '');
const isKeynote = d.kind === 'keynote';
const backHref = isKeynote ? '/keynote/' : '/other-shows/';
const backLabel = isKeynote ? 'All keynotes' : 'All shows';

const descForHead = isKeynote
  ? `Full transcript of the eCornell AI Keynote "${cleanTitle}"${guest ? ' with ' + guest : ''}, hosted by Lutz Finger.`
  : `Full transcript of ${d.show}: "${cleanTitle}", featuring Lutz Finger.`;

const articleJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${cleanTitle} — Transcript`,
  datePublished: iso,
  author: { '@type': 'Person', name: SITE.author, url: SITE.url },
  publisher: { '@type': 'Person', name: SITE.author, url: SITE.url },
  inLanguage: 'en',
  isPartOf: d.show,
};
if (d.sourceUrl) articleJsonLd.isBasedOn = d.sourceUrl;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: isKeynote ? 'Keynote' : 'Other Shows', item: `${SITE.url}${backHref}` },
    { '@type': 'ListItem', position: 3, name: `${cleanTitle} — Transcript` },
  ],
};
---
<Base
  title={`${cleanTitle}${guest ? ', with ' + guest : ''} — Transcript | Lutz Finger`}
  description={descForHead}
  type="article"
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <p style="margin-bottom:1rem"><a href={backHref}>← {backLabel}</a></p>

  <article>
    <h1>{cleanTitle}</h1>
    {guest && (
      <p style="font-size:1.15rem; color:var(--c-text-soft); margin:0.4rem 0 1rem">
        with <strong>{guest}</strong>
      </p>
    )}
    <div class="article-meta">
      <time datetime={iso}>{dateLabel}</time>
      <span>·</span>
      <span>{d.show}</span>
      <span>·</span>
      <span>Transcript</span>
    </div>

    <aside class="transcript-note">
      Auto-transcribed and lightly edited for readability. Wording is the
      speakers' own; timestamps and speaker labels are not included.
      {d.sourceUrl && (
        <> <a href={d.sourceUrl} rel="noopener" target="_blank">Listen to the original →</a></>
      )}
    </aside>

    <div class="article-body transcript-body">
      <Content />
    </div>

    <section style="margin-top:2.5rem; padding:1.25rem 1.5rem; border:1px solid var(--c-border); border-radius:6px; background:var(--c-bg-soft)">
      <p style="margin:0; font-size:0.95rem">
        <strong>About the speaker.</strong>
        Lutz Finger is Chief AI Officer at <a href="https://www.ommax.com/en_en" rel="noopener">OMMAX</a>,
        Data Scientist in Residence at Cornell SC Johnson,
        and a <a href={SITE.social.forbes} rel="noopener">Forbes contributor</a>.
        Two AI exits. Ex-Google, ex-LinkedIn, ex-Snap.
        {isKeynote
          ? <> See the full <a href="/keynote/">keynote series</a>.</>
          : <> See more <a href="/other-shows/">guest appearances</a>.</>}
      </p>
    </section>
  </article>
</Base>

<style>
  .transcript-note {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: var(--c-text-muted);
    border-left: 2px solid var(--c-border);
    padding-left: 0.85rem;
    margin: 1rem 0 1.75rem;
  }
  .transcript-body p {
    margin: 0 0 1.1em;
  }
</style>
