---
import Base from '~/layouts/Base.astro';
import WritingList from '~/components/WritingList.astro';
import WritingFilters from '~/components/WritingFilters.astro';
import WritingSearch from '~/components/WritingSearch.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('writing'))
  .filter(p => p.data.source === 'Forbes')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base
  title="Writing, Forbes column"
  description={`Lutz Finger's Forbes column, ${all.length} articles on AI products, search, GEO, LLM moats, and applied AI. Each card opens the original on forbes.com.`}
  wide
>
  <h1>Forbes column</h1>

  <WritingSearch source="Forbes" placeholder="Search the Forbes column…" />

  <WritingFilters active="forbes" />

  <div id="writing-full-list">
    <WritingList posts={all} />
  </div>
</Base>
