---
import Base from '~/layouts/Base.astro';
import WritingList from '~/components/WritingList.astro';
import WritingFilters from '~/components/WritingFilters.astro';
import WritingSearch from '~/components/WritingSearch.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('writing'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const description = `Every article by Lutz Finger — ${all.length} pieces across the Forbes column, LinkedIn, Intereconomics, NZZ, and elsewhere. Each card opens the original source.`;
---
<Base
  title="Writing"
  description={description}
  wide
>
  <h1>Writing</h1>

  <WritingSearch />

  <WritingFilters active="all" />

  <div id="writing-full-list">
    <WritingList posts={all} />
  </div>
</Base>
