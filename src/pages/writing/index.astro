---
import Base from '~/layouts/Base.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('writing'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const sources = [...new Set(all.map(p => p.data.source))];

const groups = new Map<string, typeof all>();
for (const p of all) {
  const yr = p.data.date.getFullYear().toString();
  if (!groups.has(yr)) groups.set(yr, []);
  groups.get(yr)!.push(p);
}
const years = [...groups.keys()].sort((a, b) => Number(b) - Number(a));

const description = `Every article and post by Lutz Finger — ${all.length} pieces across Forbes, LinkedIn, and elsewhere. AI, search, product strategy, data.`;
---
<Base
  title="Writing"
  description={description}
  wide
>
  <h1>Writing</h1>
  <p class="hero-sub">
    {all.length} articles — Forbes column, LinkedIn pieces, and elsewhere.
    Sorted newest first. Use the search box or filter by source.
  </p>

  <div id="search">
    <input type="search" placeholder="Search all writing (offline, instant)…" data-pagefind-search />
    <ul id="search-results" class="card-list" style="margin-top:1rem"></ul>
  </div>

  <div class="filters">
    <a href="/writing/" class="filter-chip active">All ({all.length})</a>
    {sources.map(src => (
      <a href={`#src-${src.toLowerCase()}`} class={`filter-chip tag-${src.toLowerCase()}`}>
        {src} ({all.filter(p => p.data.source === src).length})
      </a>
    ))}
  </div>

  {years.map(year => (
    <section style="margin: 2.5rem 0">
      <h2 style="border-bottom:1px solid var(--c-border); padding-bottom:0.4rem; margin-bottom:1rem; font-family:var(--font-sans); font-size:1rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--c-text-muted)">{year}</h2>
      <ul class="card-list">
        {groups.get(year)!.map(post => (
          <li>
            <a class="card" href={`/writing/${post.id}/`}>
              <div class="card-meta">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                </time>
                <span class={`tag tag-${post.data.source.toLowerCase()}`}>{post.data.source}</span>
                {post.data.tags?.slice(0, 2).map(t => <span class="tag">{t}</span>)}
              </div>
              <h3 class="card-title">{post.data.title}</h3>
              {post.data.excerpt && <p class="card-excerpt">{post.data.excerpt}</p>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<script is:inline>
  // Pagefind search — loaded at runtime from /pagefind/pagefind.js (generated by `pagefind`
  // after `astro build`). We use a runtime URL string so Vite's bundler doesn't try to
  // resolve it at build time.
  (async () => {
    const input = document.querySelector('#search input');
    const resultsEl = document.querySelector('#search-results');
    if (!input) return;
    let pagefind;
    try {
      pagefind = await import(new URL('/pagefind/pagefind.js', window.location.origin).href);
      await pagefind.options({ showImages: false });
    } catch (e) {
      input.placeholder = 'Search index not yet built — try again after deploy.';
      return;
    }
    let timer;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(async () => {
        const q = input.value.trim();
        if (!resultsEl) return;
        if (!q) { resultsEl.innerHTML = ''; return; }
        const search = await pagefind.search(q);
        const top = await Promise.all(search.results.slice(0, 12).map(r => r.data()));
        resultsEl.innerHTML = top.map(r =>
          `<li><a class="card" href="${r.url}"><h3 class="card-title">${r.meta.title ?? r.url}</h3><p class="card-excerpt">${r.excerpt}</p></a></li>`
        ).join('');
      }, 200);
    });
  })();
</script>
