---
import Base from '~/layouts/Base.astro';
import WritingList from '~/components/WritingList.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('writing'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const countBySource = (src: string) => all.filter(p => p.data.source === src).length;
const counts = {
  forbes: countBySource('Forbes'),
  linkedin: countBySource('LinkedIn'),
  intereconomics: countBySource('Intereconomics'),
  nzz: countBySource('NZZ'),
};

const description = `Every article and post by Lutz Finger — ${all.length} pieces across the Forbes column, LinkedIn, and other publications. Each card links to the original source.`;
---
<Base
  title="Writing"
  description={description}
  wide
>
  <h1>Writing</h1>
  <p class="hero-sub">
    {all.length} pieces. Each card opens the original — Forbes, LinkedIn, or
    the publication that hosts it. Filter by source below.
  </p>

  <div id="search">
    <input type="search" placeholder="Search all writing (offline, instant)…" />
    <ul id="search-results" class="card-list" style="margin-top:1rem"></ul>
  </div>

  <div class="filters">
    <a href="/writing/" class="filter-chip active">All ({all.length})</a>
    <a href="/writing/forbes/" class="filter-chip tag-forbes">Forbes ({counts.forbes})</a>
    <a href="/writing/linkedin/" class="filter-chip tag-linkedin">LinkedIn ({counts.linkedin})</a>
    {counts.intereconomics > 0 && (
      <a href="/writing/intereconomics/" class="filter-chip">Intereconomics ({counts.intereconomics})</a>
    )}
    {counts.nzz > 0 && (
      <a href="/writing/nzz/" class="filter-chip">NZZ ({counts.nzz})</a>
    )}
  </div>

  <WritingList posts={all} />
</Base>

<script is:inline>
  (async () => {
    const input = document.querySelector('#search input');
    const resultsEl = document.querySelector('#search-results');
    if (!input) return;
    let pagefind;
    try {
      pagefind = await import(new URL('/pagefind/pagefind.js', window.location.origin).href);
      await pagefind.options({ showImages: false });
    } catch (e) {
      input.placeholder = 'Search index not yet built — try again after deploy.';
      return;
    }
    let timer;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(async () => {
        const q = input.value.trim();
        if (!resultsEl) return;
        if (!q) { resultsEl.innerHTML = ''; return; }
        const search = await pagefind.search(q);
        const top = await Promise.all(search.results.slice(0, 12).map(r => r.data()));
        resultsEl.innerHTML = top.map(r =>
          `<li><a class="card" href="${r.url}" target="_blank" rel="noopener"><h3 class="card-title">${r.meta.title ?? r.url}</h3><p class="card-excerpt">${r.excerpt}</p></a></li>`
        ).join('');
      }, 200);
    });
  })();
</script>
