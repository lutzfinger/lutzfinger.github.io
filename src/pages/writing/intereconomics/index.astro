---
import Base from '~/layouts/Base.astro';
import WritingList from '~/components/WritingList.astro';
import WritingFilters from '~/components/WritingFilters.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('writing'))
  .filter(p => p.data.source === 'Intereconomics')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base
  title="Writing — Intereconomics"
  description="Lutz Finger's writing for the Intereconomics journal. Cards open the original article."
  wide
>
  <h1>Intereconomics</h1>

  <WritingFilters active="intereconomics" />

  <WritingList posts={all} groupByYear={false} />
</Base>
