---
import Base from '~/layouts/Base.astro';
import WritingList from '~/components/WritingList.astro';
import WritingFilters from '~/components/WritingFilters.astro';
import WritingSearch from '~/components/WritingSearch.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('writing'))
  .filter(p => p.data.source === 'Intereconomics')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base
  title="Intereconomics Articles by Lutz Finger | Europe, AI, Data Power"
  description="Lutz Finger's writing for the Intereconomics journal. Cards open the original article."
  wide
>
  <h1>Intereconomics</h1>

  <p class="page-lead">
    Peer-reviewed articles by Lutz Finger in the
    <a href="https://www.intereconomics.eu/" rel="noopener">Intereconomics</a>
    journal: on data as the new geopolitical power (2019) and on Europe's
    position in the AI race vs the U.S. and China (2025). Each card opens
    the article on intereconomics.eu.
  </p>

  <WritingSearch source="Intereconomics" placeholder="Search Intereconomics pieces…" />

  <WritingFilters active="intereconomics" />

  <div id="writing-full-list">
    <WritingList posts={all} groupByYear={false} />
  </div>
</Base>
