---
import Base from '~/layouts/Base.astro';
import WritingList from '~/components/WritingList.astro';
import WritingFilters from '~/components/WritingFilters.astro';
import WritingSearch from '~/components/WritingSearch.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('writing'))
  .filter(p => p.data.source === 'LinkedIn')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base
  title="Writing, LinkedIn"
  description={`Lutz Finger's LinkedIn articles, ${all.length} pieces. Each card opens the original on LinkedIn.`}
  wide
>
  <h1>LinkedIn</h1>

  <WritingSearch source="LinkedIn" placeholder="Search LinkedIn articles…" />

  <WritingFilters active="linkedin" />

  <div id="writing-full-list">
    <WritingList posts={all} />
  </div>
</Base>
