---
import Base from '~/layouts/Base.astro';
import WritingList from '~/components/WritingList.astro';
import WritingFilters from '~/components/WritingFilters.astro';
import WritingSearch from '~/components/WritingSearch.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('writing'))
  .filter(p => p.data.source === 'LinkedIn')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base
  title="LinkedIn Articles by Lutz Finger | AI, Data, Product Strategy"
  description={`Lutz Finger's LinkedIn articles, ${all.length} pieces. Each card opens the original on LinkedIn.`}
  wide
>
  <h1>LinkedIn</h1>

  <p class="page-lead">
    Long-form articles Lutz Finger has published on LinkedIn Pulse since
    2014: data products, social-media analytics, AI strategy, founder
    stories. Each card opens the original article on LinkedIn.
  </p>

  <WritingSearch source="LinkedIn" placeholder="Search LinkedIn articles…" />

  <WritingFilters active="linkedin" />

  <div id="writing-full-list">
    <WritingList posts={all} />
  </div>
</Base>
