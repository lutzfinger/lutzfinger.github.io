---
import Base from '~/layouts/Base.astro';
import WritingList from '~/components/WritingList.astro';
import WritingFilters from '~/components/WritingFilters.astro';
import WritingSearch from '~/components/WritingSearch.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('writing'))
  .filter(p => p.data.source === 'NZZ')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base
  title="NZZ Guest Opinion by Lutz Finger — Europe in the AI Race"
  description="Lutz Finger's guest contributions to the Neue Zürcher Zeitung (NZZ)."
  wide
>
  <h1>Neue Zürcher Zeitung</h1>

  <p class="page-lead">
    Guest opinion pieces by Lutz Finger in the
    <a href="https://www.nzz.ch/" rel="noopener">Neue Zürcher Zeitung</a>
    (NZZ), Switzerland's paper of record. On Europe's AI strategy and the
    geopolitical implications of falling behind the U.S. and China.
  </p>

  <WritingSearch source="NZZ" placeholder="Search NZZ pieces…" />

  <WritingFilters active="nzz" />

  <div id="writing-full-list">
    <WritingList posts={all} groupByYear={false} />
  </div>
</Base>
